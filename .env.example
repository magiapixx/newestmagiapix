# Where the contact form posts its FormData (e.g. a Formspree / Basin / own API URL).
# When unset, the form uses FormSubmit to deliver to hello@magiapix.com (temporary).
# Set it to an empty value to make the form open the visitor's mail app instead.
PUBLIC_CONTACT_ENDPOINT=https://formsubmit.co/ajax/hello@magiapix.com
