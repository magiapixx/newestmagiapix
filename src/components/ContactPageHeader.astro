const root = rv({ lg: 'v-x8kkmy', xl: 'v-x8kkmy', t: 'v-119hw8o', p: 'v-1ue3ng4' });
---

<header class:list={["m-hMwLZ m-x8kkmy", root]} style="background-color:var(--color-black, rgb(0, 0, 0));height:100%;width:100%"
