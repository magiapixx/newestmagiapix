---
// Hero - Section: one markup for every breakpoint (lib/rv)
import HeadingsVertical from './HeadingsVertical.astro';
import LinkWithLine from './LinkWithLine.astro';
import PlusMedium from './PlusMedium.astro';
import { rv } from '../lib/rv';

const look = rv({ lg: 'v-4wrg1e', xl: 'v-n3a0um', t: 'v-1c80epy', p: 'v-1m0gzn2' });
const place = rv({ lg: 'type-1xxob9n', xl: 'type-1xxob9n', t: 'type-1xxob9n', p: 'type-y2tuor' });
---

<header class:list={["m-y5R0E m-dS8v4 m-xbhBc m-4wrg1e", look]} style="background-color:var(--color-black, rgb(0, 0, 0));height:100%;width:100%"
  ><div class="m-19xt6zm"
    ><div class="m-1j63tim-container"
      ><div style="position:relative;width:100%;height:100%;overflow:hidden;background:#050505"
        ><canvas style="position:absolute;inset:0;width:100%;height:100%;display:block" data-gl="blocks"></canvas
      ></div
    ></div
  ></div
  ><div class="hero-layout"
    ><div class="hero-title"
      ><div class="m-ing148 hero-tagline"><p>MAGIAPIX<br />DIGITAL<br />AGENCY</p></div
    ></div
    ><div class="hero-meta"
      ><div class="m-1ngrm4v" style="--extracted-1w1cjl5:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;transform:none"
        ><h6 class={`rt ${place}`} dir="auto" style="--m-text-color:var(--extracted-1w1cjl5, var(--color-white, rgb(255, 255, 255)))">LONDON, UK</h6
      ></div
    ></div
    ><div class="hero-cta"
      ><div class="m-10mfzsy-container"
        ><LinkWithLine link="/about/#contact" text="START PROJECT"></LinkWithLine
      ></div
    ></div
    ><div class="hero-scroll"
      ><HeadingsVertical variants={{ lg: "Scroll Down - H6", xl: "Scroll Down - H6", t: "Scroll Down - H6 - Smaller", p: "Scroll Down - H6 - Smaller" }}></HeadingsVertical
    ></div
    ><div class="hero-rail"
      ><PlusMedium class="hero-plus" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusMedium
      ><span class="hero-rail-line"></span
      ><PlusMedium class="hero-plus" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusMedium
    ></div
  ></div
></header>
