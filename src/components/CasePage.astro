---
// Main - Case
import CaseStudy from './CaseStudy.astro';
import FooterSection from './FooterSection.astro';

interface Props {
  caseStudyDataSrc: string;
  caseStudyText: string;
  caseStudyImage1Image: any;
  caseStudyHasMainInfo?: boolean;
  caseStudyClient: string;
  caseStudyYearDatetime: string;
  caseStudyYear: string;
  caseStudyServices: string;
  caseStudyImage2Style: string;
  caseStudyImage2Image: any;
  caseStudyImage3Image: any;
  caseStudyImage4Image: any;
  caseStudyHasImages?: boolean;
  caseStudyHasBlock?: boolean;
  caseStudyPrevNextLink?: string;
  caseStudyPrevNextDataSrc?: string;
  caseStudyPrevNextText?: string;
  caseStudyPrevNextLink2?: string;
  caseStudyPrevNextDataSrc2?: string;
  caseStudyPrevNextText2?: string;
  caseStudyHasImages2?: boolean;
  caseStudyMainInfoClass?: string;
  footerSectionAvaImage: any;
  footerSectionLinkWithLineSmallLink: string;
}

const { caseStudyDataSrc, caseStudyText, caseStudyImage1Image, caseStudyHasMainInfo, caseStudyClient, caseStudyYearDatetime, caseStudyYear, caseStudyServices, caseStudyImage2Style, caseStudyImage2Image, caseStudyImage3Image, caseStudyImage4Image, caseStudyHasImages, caseStudyHasBlock, caseStudyPrevNextLink, caseStudyPrevNextDataSrc, caseStudyPrevNextText, caseStudyPrevNextLink2, caseStudyPrevNextDataSrc2, caseStudyPrevNextText2, caseStudyHasImages2, caseStudyMainInfoClass, footerSectionAvaImage, footerSectionLinkWithLineSmallLink } = Astro.props;
---

<div class="m-2Kuhf m-1tr0fx7" style="min-height:100vh;width:auto"
  ><CaseStudy dataSrc={caseStudyDataSrc} text={caseStudyText} image1Image={caseStudyImage1Image} hasMainInfo={caseStudyHasMainInfo} client={caseStudyClient} yearDatetime={caseStudyYearDatetime} year={caseStudyYear} services={caseStudyServices} image2Style={caseStudyImage2Style} image2Image={caseStudyImage2Image} image3Image={caseStudyImage3Image} image4Image={caseStudyImage4Image} hasImages={caseStudyHasImages} hasBlock={caseStudyHasBlock} prevNextLink={caseStudyPrevNextLink} prevNextDataSrc={caseStudyPrevNextDataSrc} prevNextText={caseStudyPrevNextText} prevNextLink2={caseStudyPrevNextLink2} prevNextDataSrc2={caseStudyPrevNextDataSrc2} prevNextText2={caseStudyPrevNextText2} hasImages2={caseStudyHasImages2} mainInfoClass={caseStudyMainInfoClass}></CaseStudy
  ><div id="overlay"></div
  ><div class="m-143slgo"></div
  ><div class="bp hide-phone"
    ><div class="m-xez8hd-container"
      ><div class="bp hide-tablet"
        ><FooterSection variant="Desktop" avaImage={footerSectionAvaImage} linkWithLineSmallLink={footerSectionLinkWithLineSmallLink}></FooterSection
      ></div
      ><div class="bp hide-desktop"
        ><FooterSection variant="Tablet" avaImage={footerSectionAvaImage} linkWithLineSmallLink={footerSectionLinkWithLineSmallLink}></FooterSection
      ></div
    ></div
  ></div
  ><div class="bp hide-tablet hide-desktop"
    ><div class="m-xez8hd-container"
      ><FooterSection variant="Phone" avaImage={footerSectionAvaImage} linkWithLineSmallLink={footerSectionLinkWithLineSmallLink}></FooterSection
    ></div
  ></div
></div>