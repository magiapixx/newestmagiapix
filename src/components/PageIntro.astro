---
// Page intro: accent columns covering the page on load (animated by scripts/components/intro.ts)
// The columns overlap by 1px: their widths are fractional and each is its own layer, so edge to edge the page
// showed through as a hairline between them
---

<div aria-hidden="true" style="position:fixed;inset:0;z-index:9999;display:flex;gap:0;width:100vw;height:100dvh;overflow:hidden;pointer-events:all" data-intro=""
  ><div style="flex:1 1 0%;min-width:0;height:100%;background-color:var(--color-accent, rgb(0, 255, 161));transform-origin:50% 50%;will-change:transform;transform:none"></div
  ><div style="flex:1 1 0%;min-width:0;margin-left:-1px;height:100%;background-color:var(--color-accent, rgb(0, 255, 161));transform-origin:50% 50%;will-change:transform;transform:none"></div
  ><div style="flex:1 1 0%;min-width:0;margin-left:-1px;height:100%;background-color:var(--color-accent, rgb(0, 255, 161));transform-origin:50% 50%;will-change:transform;transform:none"></div
  ><div style="flex:1 1 0%;min-width:0;margin-left:-1px;height:100%;background-color:var(--color-accent, rgb(0, 255, 161));transform-origin:50% 50%;will-change:transform;transform:none"></div
></div>
