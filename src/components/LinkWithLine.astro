---
// Link With Line
import Line from './Line.astro';
import LineAnimated from './LineAnimated.astro';

interface Props {
  link: string;
  target?: string;
  text: string;
}

const { link, target, text } = Astro.props;
---

<a class="m-4oV3m m-dS8v4 m-alehh m-gaa7tb v-gaa7tb m-3hjk3h" href={link} style="height:100%" target={target}
  ><div class="m-9bnb9v" style="--extracted-1w1cjl5:var(--prop-GffgxLMr6);--m-paragraph-spacing:0px;--prop-GffgxLMr6:var(--color-accent, rgb(0, 255, 161));transform:none"
    ><h6 class="rt type-1xxob9n" dir="auto" style="--m-text-color:var(--extracted-1w1cjl5, var(--prop-GffgxLMr6))">{text}</h6
  ></div
  ><Line class="m-1o2sg9a"></Line
  ><LineAnimated class="m-gtvap4"></LineAnimated
></a>