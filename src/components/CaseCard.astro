---
// Case - Card: one markup that takes a look per breakpoint (lib/rv). The hover accent bar exists only in the
// desktop look; the title type follows the breakpoint's look.
import AnimationAccent from './AnimationAccent.astro';
import { BPS, hideWhere, rv, type PerBp } from '../lib/rv';

const VARIANTS = {
  "Desktop": "v-12q4b40",
  "Tablet": "v-f8crww",
  "Phone": "v-1q5orec",
};
const TITLE = { "Desktop": "type-4dgq3i", "Tablet": "type-9iwysc", "Phone": "type-1qeok15" };
type Name = keyof typeof VARIANTS;

interface Props {
  variants: PerBp<Name>;
  link: string;
  dataSrc: string;
  text: string;
  text2: string;
}

const { variants, link, dataSrc, text, text2 } = Astro.props;
const at = <T,>(table: Record<Name, T>) => Object.fromEntries(BPS.map((b) => [b, table[variants[b]]])) as PerBp<T>;
const look = rv(at(VARIANTS));
const title = rv(at(TITLE));
const accent = hideWhere(at({ "Desktop": true, "Tablet": false, "Phone": false }));
---

<a class:list={["m-6eFUg m-kXq9A m-OjHb3 m-5BKxZ m-12q4b40 m-m8rpda", look]} href={link} style="width:100%"
  ><div class="m-11ltetc-container"
    ><div style="width:100%;position:relative;height:auto;min-height:0;max-height:none;aspect-ratio:1.7777777777777777;overflow:hidden;background:transparent"
      ><canvas style="position:absolute;inset:0;display:block;width:100%;height:100%" data-gl="pixel-flip" data-src={dataSrc} aria-hidden="true"></canvas
    ></div
  ></div
  ><div class="m-zxl6o5" style="transform:translateX(-50%)"
    ><div class:list={["m-1f8aats", accent]} data-show="hover"
      ><div class="m-y2q957-container"
        ><AnimationAccent variant="v-1ejt96b" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
      ></div
    ></div
    ><div class="m-1x3aaxs" style="--extracted-a0htzi:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;--extracted-1eung3n:var(--color-white, rgb(255, 255, 255));--extracted-1lwpl3i:var(--color-white, rgb(255, 255, 255));transform:none"
      ><h3 class={`rt ${title}`} dir="auto" style="--m-text-color:var(--extracted-a0htzi, var(--color-white, rgb(255, 255, 255)))">{text}</h3
    ></div
    ><div class="m-1sd318b" style="--extracted-a0htzi:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;--extracted-1eung3n:var(--color-white, rgb(255, 255, 255));--extracted-1lwpl3i:var(--color-white, rgb(255, 255, 255));transform:none"
      ><h3 class={`rt ${title}`} dir="auto" style="--m-text-color:var(--extracted-a0htzi, var(--color-white, rgb(255, 255, 255)))">{text2}</h3
    ></div
  ></div
></a>
