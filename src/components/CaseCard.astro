---
// Case - Card
import AnimationAccent from './AnimationAccent.astro';

interface Props {
  variant?: "Desktop" | "Tablet" | "Phone";
  link: string;
  dataSrc: string;
  text: string;
  text2: string;
}

const { variant = "Desktop", link, dataSrc, text, text2 } = Astro.props;

const VARIANTS = {
  "Desktop": "v-12q4b40",
  "Tablet": "v-f8crww",
  "Phone": "v-1q5orec",
};
---

{
  variant === "Desktop" ? (
    <Fragment
      ><a class:list={["m-6eFUg m-kXq9A m-OjHb3 m-5BKxZ m-12q4b40 m-m8rpda", VARIANTS[variant]]} href={link} style="width:100%"
        ><div class="m-11ltetc-container"
          ><div style="width:100%;position:relative;height:auto;min-height:0;max-height:none;aspect-ratio:1.7777777777777777;overflow:hidden;background:transparent"
            ><canvas style="position:absolute;inset:0;display:block;width:100%;height:100%" data-gl="pixel-flip" data-src={dataSrc} aria-hidden="true"></canvas
          ></div
        ></div
        ><div class="m-zxl6o5" style="transform:translateX(-50%)"
          ><div class="m-1f8aats" data-show="hover"
            ><div class="m-y2q957-container"
              ><AnimationAccent variant="v-1ejt96b" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
            ></div
          ></div
          ><div class="m-1x3aaxs" style="--extracted-a0htzi:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;transform:none"
            ><h3 class="rt type-4dgq3i" dir="auto" style="--m-text-color:var(--extracted-a0htzi, var(--color-white, rgb(255, 255, 255)))">{text}</h3
          ></div
          ><div class="m-1sd318b" style="--extracted-a0htzi:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;transform:none"
            ><h3 class="rt type-4dgq3i" dir="auto" style="--m-text-color:var(--extracted-a0htzi, var(--color-white, rgb(255, 255, 255)))">{text2}</h3
          ></div
        ></div
      ></a></Fragment
    >
  ) : variant === "Tablet" ? (
    <Fragment
      ><a class:list={["m-6eFUg m-kXq9A m-OjHb3 m-5BKxZ m-12q4b40 m-m8rpda", VARIANTS[variant]]} href={link} style="width:100%"
        ><div class="m-11ltetc-container"
          ><div style="width:100%;position:relative;height:auto;min-height:0;max-height:none;aspect-ratio:1.7777777777777777;overflow:hidden;background:transparent"
            ><canvas style="position:absolute;inset:0;display:block;width:100%;height:100%" data-gl="pixel-flip" data-src={dataSrc} aria-hidden="true"></canvas
          ></div
        ></div
        ><div class="m-zxl6o5" style="transform:translateX(-50%)"
          ><div class="m-1x3aaxs" style="--extracted-a0htzi:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;--extracted-1eung3n:var(--color-white, rgb(255, 255, 255));transform:none"
            ><h4 class="rt type-9iwysc" dir="auto" style="--m-text-color:var(--extracted-1eung3n, var(--color-white, rgb(255, 255, 255)))">{text}</h4
          ></div
          ><div class="m-1sd318b" style="--extracted-a0htzi:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;--extracted-1eung3n:var(--color-white, rgb(255, 255, 255));transform:none"
            ><h4 class="rt type-9iwysc" dir="auto" style="--m-text-color:var(--extracted-1eung3n, var(--color-white, rgb(255, 255, 255)))">{text2}</h4
          ></div
        ></div
      ></a></Fragment
    >
  ) : variant === "Phone" ? (
    <Fragment
      ><a class:list={["m-6eFUg m-kXq9A m-OjHb3 m-5BKxZ m-12q4b40 m-m8rpda", VARIANTS[variant]]} href={link} style="width:100%"
        ><div class="m-11ltetc-container"
          ><div style="width:100%;position:relative;height:auto;min-height:0;max-height:none;aspect-ratio:1.7777777777777777;overflow:hidden;background:transparent"
            ><canvas style="position:absolute;inset:0;display:block;width:100%;height:100%" data-gl="pixel-flip" data-src={dataSrc} aria-hidden="true"></canvas
          ></div
        ></div
        ><div class="m-zxl6o5" style="transform:translateX(-50%)"
          ><div class="m-1x3aaxs" style="--extracted-a0htzi:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;--extracted-1lwpl3i:var(--color-white, rgb(255, 255, 255));transform:none"
            ><h5 class="rt type-1qeok15" dir="auto" style="--m-text-color:var(--extracted-1lwpl3i, var(--color-white, rgb(255, 255, 255)))">{text}</h5
          ></div
          ><div class="m-1sd318b" style="--extracted-a0htzi:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;--extracted-1lwpl3i:var(--color-white, rgb(255, 255, 255));transform:none"
            ><h5 class="rt type-1qeok15" dir="auto" style="--m-text-color:var(--extracted-1lwpl3i, var(--color-white, rgb(255, 255, 255)))">{text2}</h5
          ></div
        ></div
      ></a></Fragment
    >
  ) : null
}