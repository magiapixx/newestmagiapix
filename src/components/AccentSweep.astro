---
// Accent bars that sweep across the text block they sit in, one per quarter of its height, as in Text - Back
// Animation. Put it first inside a `data-scramble="sweep"` element so the letters decode as the bars pass;
// scripts/components/scroll-variants.ts plays the bars when the block comes into view
import AnimationAccent from './AnimationAccent.astro';

const BARS = ['v-1ejt96b', 'v-12el1mb', 'v-1hn00ti', 'v-zdic29'] as const;
---

<div class="sweep-bars hide-phone" aria-hidden="true"
  >{BARS.map((variant) => (
    <div class="sweep-row"
      ><AnimationAccent variant={variant} style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(157, 140, 255))"></AnimationAccent
    ></div>
  ))}</div
>

<style>
  .sweep-bars {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }
  .sweep-row {
    flex: none;
    width: 100%;
    height: 25%;
    position: relative;
  }
  /* the text paints over the bars */
  .sweep-bars ~ :global(*) {
    position: relative;
  }
</style>
