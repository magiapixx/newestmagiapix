---
// Service: one markup for every breakpoint (lib/rv). The title has a desktop block (h3) and a tablet/phone
// block (h5); the image inset (--sezid2) per breakpoint is set in site.css.
import ImageOpening from './ImageOpening.astro';
import MinusBig from './MinusBig.astro';
import PlusBig from './PlusBig.astro';
import { rv } from '../lib/rv';

interface Props {
  imageOpeningImage: any;
  text: string;
  text3: string;
  text4: string;
}

const { imageOpeningImage, text, text3, text4 } = Astro.props;
const look = rv({ lg: 'v-15zdchv', xl: 'v-15zdchv', t: 'v-15zdchv', p: 'v-1gx16xq' });
---

<div class:list={["m-Fsg4m m-zNzez m-pQ5hH m-lhYZM m-alehh m-xbhBc m-15zdchv", look]} tabindex="0" style="background-color:var(--color-white, rgb(255, 255, 255));width:100%"
  ><div class="m-113k14r"
    ><div class="m-10m0ylc"
      ><div class="m-1q569jd-container"
        ><ImageOpening image={imageOpeningImage}></ImageOpening
