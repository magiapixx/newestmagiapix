    ><div class="m-12wev4a"
      ><div class="m-1km02il" style="--extracted-r6o4lv:var(--color-black, rgb(0, 0, 0));--m-paragraph-spacing:0px;transform:none"
        ><p class="rt type-m3s7sn" dir="auto" style="--m-text-color:var(--extracted-r6o4lv, var(--color-black, rgb(0, 0, 0)))">{text3}</p
      ></div
      ><div class="m-sst7c" style="--extracted-1a3g3q6:var(--color-black, rgb(0, 0, 0));--extracted-1o9v4yh:var(--color-black, rgb(0, 0, 0));--extracted-1w1cjl5:var(--color-black, rgb(0, 0, 0));--extracted-6komju:var(--color-black, rgb(0, 0, 0));--extracted-9fz5vb:var(--color-black, rgb(0, 0, 0));--extracted-bnc66o:var(--color-black, rgb(0, 0, 0));--m-paragraph-spacing:0px;transform:none"
