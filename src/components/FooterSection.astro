---
// Footer - Section: dark, no background effects. Top row: studio statement on the left, (Menu) and (Socials)
// link columns on the right. A hairline, then contact, studio address, a start-a-project link and a back-to-top
// arrow. Then the big faint MAGIAPIX wordmark and a bottom bar (copyright, privacy and terms).
interface Props {
  linkWithLineSmallLink: string;
}

const { linkWithLineSmallLink } = Astro.props;

const menu = [
  { label: 'Home', href: '/' },
  { label: 'Cases', href: '/cases/' },
  { label: 'About', href: '/about/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: linkWithLineSmallLink },
];

const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/' },
  { label: 'Instagram', href: 'https://www.instagram.com/' },
  { label: 'Behance', href: 'https://www.behance.net/' },
  { label: 'X', href: 'https://x.com/' },
  { label: 'WhatsApp', href: 'https://wa.me/' },
];
---

<footer class="ft">
  <section class="ft-cta-hero">
    <p class="ft-label">(New project?)</p>
    <h2 class="ft-cta-head">Let’s build something legendary</h2>
    <div class="ft-cta-actions">
      <a class="ft-btn ft-btn-solid" href={linkWithLineSmallLink}>Start a project</a>
    </div>
  </section>

  <div class="ft-top">
    <p class="ft-head">Magiapix is a creative studio in London for brands that would rather be remembered than noticed.</p>
    <nav class="ft-col" aria-label="Footer">
      <p class="ft-label">(Menu)</p>
      <ul>{menu.map((m) => <li><a href={m.href}>{m.label}</a></li>)}</ul>
    </nav>
    <div class="ft-col">
      <p class="ft-label">(Socials)</p>
      <ul>{socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
    </div>
  </div>

  <div class="ft-info">
    <div class="ft-col ft-contact">
      <p class="ft-label">(Contact)</p>
      <a class="ft-email" href="mailto:hello@magiapix.com">hello@magiapix.com</a>
    </div>
    <div class="ft-col">
      <p class="ft-label">(London)</p>
      <p>18-22 Corsham St, Hoxton<br />London N1 6DR, UK<br />GMT — GMT+0</p>
    </div>
    <div class="ft-col">
      <p class="ft-label">(New project)</p>
      <a class="ft-cta" href={linkWithLineSmallLink}>Start a project →</a>
    </div>
    <button class="ft-top-btn" type="button" aria-label="Back to top" data-to-top>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21V4M5 11l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </button>
  </div>

  <div class="ft-mark" aria-hidden="true"><span>MAGIAPIX</span></div>

  <div class="ft-bottom">
    <p>©2026 Magiapix Agency. All rights reserved.</p>
    <p>18-22 Corsham St, London</p>
  </div>
</footer>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-to-top]')) {
    button.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  }
</script>

<style>
  .ft {
    --ft-pad: clamp(15px, 1.25vw, 24px);
    --ft-muted: rgba(255, 255, 255, .5);
    --ft-line: rgba(255, 255, 255, .14);
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: clamp(60px, 4vw, 80px) var(--ft-pad) var(--ft-pad);
    background: #0b0b0b;
    color: #fff;
    font-family: "Zalando Sans Variable", "Zalando Sans Variable Placeholder", sans-serif;
    font-size: 15px;
    font-variation-settings: "wght" 450;
    line-height: 1.5;
  }
  .ft :is(p, ul) { margin: 0; }
  .ft ul { list-style: none; padding: 0; }
  .ft a { color: inherit; text-decoration: none; transition: color .2s; }
  .ft a:hover, .ft a:focus-visible { color: var(--color-accent, #9d8cff); }

  /* call to action above the footer columns: one full screen tall, everything centred */
  .ft-cta-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(24px, 2.5vw, 48px);
    min-height: calc(100vh / var(--z, 1));
    margin-top: calc(-1 * clamp(60px, 4vw, 80px));
    margin-bottom: clamp(40px, 4vw, 80px);
    text-align: center;
  }
  .ft-cta-head {
    margin: 0;
    max-width: 13em;
    font-size: clamp(44px, 8.4vw, 170px);
    font-weight: 800;
    font-variation-settings: "wght" 800;
    line-height: .9;
    letter-spacing: -.05em;
    text-transform: uppercase;
  }
  .ft-cta-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .ft .ft-btn {
    display: inline-flex;
    align-items: center;
    padding: 14px 28px;
    border: 1px solid rgba(255, 255, 255, .8);
    font-size: 15px;
    font-variation-settings: "wght" 500;
    text-transform: uppercase;
    transition: background-color .25s, color .25s, border-color .25s;
  }
  .ft .ft-btn-solid { background: #fff; border-color: #fff; color: #0b0b0b; }
  .ft .ft-btn:hover, .ft .ft-btn:focus-visible { background: var(--color-accent, #9d8cff); border-color: var(--color-accent, #9d8cff); color: #0b0b0b; }

  /* four even columns from tablet up: the statement spans the first two, menu and socials take the last two */
  .ft-top, .ft-info {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 20px;
  }
  .ft-head {
    grid-column: 1 / 3;
    max-width: 19em;
    font-size: clamp(24px, 1.75vw, 34px);
    font-weight: 600;
    font-variation-settings: "wght" 600;
    line-height: 1.08;
    letter-spacing: -.03em;
    text-transform: uppercase;
  }
  .ft-label { color: var(--ft-muted); text-transform: uppercase; }
  .ft-col ul { font-variation-settings: "wght" 560; }

  .ft-info {
    position: relative;
    margin-top: clamp(50px, 3vw, 60px);
    padding-top: 26px;
    border-top: 1px solid var(--ft-line);
  }
  .ft-contact { grid-column: 1 / 3; }
  .ft-email {
    display: inline-block;
    font-size: clamp(24px, 1.75vw, 34px);
    font-variation-settings: "wght" 600;
    line-height: 1.2;
    letter-spacing: -.03em;
    text-transform: uppercase;
  }
  .ft-cta {
    text-decoration: underline !important;
    text-underline-offset: 3px;
    font-variation-settings: "wght" 600;
    text-transform: uppercase;
  }
  .ft-top-btn {
    position: absolute;
    top: 26px;
    right: 0;
    width: 40px;
    height: 40px;
    padding: 8px;
    border: 0;
    background: none;
    color: #fff;
    cursor: pointer;
    transition: transform .3s cubic-bezier(.2, .7, .2, 1), color .2s;
  }
  .ft-top-btn:hover { color: var(--color-accent, #9d8cff); transform: translateY(-4px); }
  .ft-top-btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .ft-top-btn svg { display: block; width: 100%; height: 100%; }

  /* wordmark: MAGIAPIX is ~4.82em wide at this weight, so box width / 4.85em fills the width */
  .ft-mark {
    margin-top: clamp(60px, 6vw, 110px);
    color: #222;
    container-type: inline-size;
    line-height: 0;
  }
  .ft-mark > span {
    display: block;
    font-size: calc(100cqw / 4.85);
    font-weight: 900;
    font-variation-settings: "wght" 900;
    line-height: .78;
    letter-spacing: -.045em;
    white-space: nowrap;
  }

  .ft-bottom {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 20px;
    margin-top: clamp(40px, 4vw, 80px);
    color: var(--ft-muted);
    font-size: 13px;
    text-transform: uppercase;
  }
  .ft-bottom > p:first-child { grid-column: 1 / 3; }

  /* phone: one column, statement first, menu and socials side by side, then the info blocks stacked */
  @media (max-width: 809.98px) {
    .ft-top, .ft-info, .ft-bottom { grid-template-columns: 1fr 1fr; row-gap: 32px; }
    .ft-head, .ft-contact, .ft-bottom > p:first-child { grid-column: 1 / -1; }
    .ft-bottom { row-gap: 10px; }
    .ft-mark > span { font-size: calc(100cqw / 4.85); }
  }
</style>
