---
// Footer - Section: plain black, no background effects. Headline + two pill buttons and a social column on top,
// a big MAGIAPIX wordmark, then a centred one-line meta bar (copyright, email)
interface Props {
  linkWithLineSmallLink: string;
}

const { linkWithLineSmallLink } = Astro.props;

const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/' },
  { label: 'Instagram', href: 'https://www.instagram.com/' },
  { label: 'Behance', href: 'https://www.behance.net/' },
  { label: 'X', href: 'https://x.com/' },
  { label: 'WhatsApp', href: 'https://wa.me/' },
];
---

<footer class="ft">
  <div class="ft-top">
    <div class="ft-lead">
      <h2 class="ft-head">Come say<br />hello<span class="ft-accent">.</span></h2>
      <div class="ft-actions">
        <a class="ft-pill" href={linkWithLineSmallLink}>Start a project</a>
        <a class="ft-pill" href="mailto:hello@magiapix.com">Drop us an email</a>
      </div>
    </div>
    <ul class="ft-social">
      {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
    </ul>
  </div>

  <div class="ft-mark" aria-hidden="true"><span>MAGIAPIX</span></div>

  <div class="ft-meta">
    <p>© 2026 Magiapix Agency — <a href="mailto:hello@magiapix.com">hello@magiapix.com</a></p>
  </div>
</footer>

<style>
  .ft {
    --ft-pad: clamp(15px, 1.25vw, 24px);
    /* dark ink for white surface; accent darkened for readable text, the bright accent stays on the solid pill */
    /* white ink on black; the bright site accent reads well on black, so no darkened accent is needed */
    --ft-bg: var(--color-black, #000);
    --ft-ink: #fff;
    --ft-accent: var(--color-accent, #9d8cff);
    --ft-line: rgba(255, 255, 255, .32);
    --ft-muted: rgba(255, 255, 255, .6);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 3vw, 60px);
    width: 100%;
    padding: clamp(80px, 5vw, 100px) var(--ft-pad) var(--ft-pad);
    background: var(--ft-bg);
    color: var(--ft-ink);
    font-family: "Zalando Sans Variable", "Zalando Sans Variable Placeholder", sans-serif;
  }
  .ft a { color: inherit; text-decoration: none; }
  /* desktop only: at least one screen tall, the wordmark and meta line at the bottom (.ft-mark margin-top: auto);
     tablet and phone keep the height of the content */
  @media (min-width: 1200px) {
    .ft { min-height: calc(100vh / var(--z, 1)); }
  }

  /* headline and pills on the left, the socials below the buttons on the right edge. The top block takes the free
     height of the screen-tall desktop footer and the socials drop to its bottom, so they always sit one footer gap
     above the wordmark and the empty space opens between the buttons and the socials instead */
  .ft-top {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 3vw, 40px);
  }
  .ft-social { align-self: flex-end; margin-top: auto; text-align: right; }
  .ft-head {
    margin: 0;
    font-size: clamp(48px, 6.25vw, 120px);
    font-weight: 800;
    font-variation-settings: "wght" 800;
    line-height: 1;
    letter-spacing: -.03em;
  }
  .ft-accent { color: var(--ft-accent); }

  .ft-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(28px, 2.2vw, 40px);
  }
  /* square buttons in monospace caps: the first solid accent, the second outlined; both turn black on hover */
  .ft-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    /* padding and type scale with the screen width, from phone to wide desktop */
    padding: clamp(11px, .9vw, 18px) clamp(16px, 1.6vw, 28px);
    border: 1px solid var(--ft-line);
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: clamp(11px, calc(9px + .35vw), 15px);
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color .25s, color .25s, border-color .25s;
  }
  /* .ft prefix: outranks `.ft a { color: inherit }` */
  .ft .ft-pill:first-child { background: var(--ft-accent); border-color: var(--ft-accent); color: #fff; }
  /* the second button is filled too, in dark grey, with no visible border (the border stays transparent so both
     buttons keep the same size) */
  .ft .ft-pill:nth-child(2) { background: var(--color-gray-850, #242424); border-color: transparent; color: #fff; }
  /* hover inverts to white with black text */
  .ft .ft-pill:hover, .ft .ft-pill:focus-visible { background: var(--ft-ink); border-color: var(--ft-ink); color: var(--ft-bg); }
  .ft-pill:focus-visible { outline: 2px solid var(--ft-ink); outline-offset: 3px; }

  .ft-social {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: calc(clamp(22px, 1.7vw, 32px) * .78);
    font-weight: 560;
    font-variation-settings: "wght" 560;
    line-height: 1.15;
    letter-spacing: -.01em;
  }
  .ft-social a:hover { color: var(--ft-accent); }

  /* wordmark: MAGIAPIX is ~4.82em wide at this weight, so box width / 4.85em fills the width with a hair to spare,
     the same at every breakpoint */
  .ft-mark {
    /* faded white, the same 20% as the faded vertical section headings */
    color: rgba(255, 255, 255, .2);
    /* pushed to the bottom of the screen-tall footer */
    margin-top: auto;
    container-type: inline-size;
    line-height: 0;
  }
  .ft-mark > span {
    display: block;
    font-size: calc(100cqw / 4.85);
    font-weight: 900;
    font-variation-settings: "wght" 900;
    line-height: .78;
    letter-spacing: -.045em;
    white-space: nowrap;
  }

  .ft-meta {
    display: flex;
    justify-content: center;
    text-align: center;
    color: var(--ft-muted);
    font-size: 14px;
  }
  /* sits close under the wordmark: cancel most of the footer's column gap */
  .ft-mark + .ft-meta { margin-top: calc(24px - clamp(32px, 3vw, 60px)); }
  .ft-meta p { margin: 0; }
  .ft-meta a:hover { color: var(--ft-accent); }

  /* phone: the pills stay side by side at their own size (they wrap only when the screen is too narrow), socials
     under them on the right as on desktop; the meta line stays centred */
  @media (max-width: 809.98px) {
    .ft-actions { gap: 10px; }
    .ft-meta { font-size: 12px; }
  }
</style>
