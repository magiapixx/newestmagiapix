---
// Footer - Section: plain black, no background effects. Headline + two pill buttons and a social column on top,
// a full-width MAGIAPIX wordmark, then a centred one-line meta bar (copyright, address, email)
interface Props {
  linkWithLineSmallLink: string;
}

const { linkWithLineSmallLink } = Astro.props;

const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/' },
  { label: 'Instagram', href: 'https://www.instagram.com/' },
  { label: 'Behance', href: 'https://www.behance.net/' },
  { label: 'X', href: 'https://x.com/' },
  { label: 'WhatsApp', href: 'https://wa.me/' },
];
---

<footer class="ft">
  <div class="ft-top">
    <div class="ft-lead">
      <h2 class="ft-head">Let's make<br />some magic<span class="ft-accent">.</span></h2>
      <div class="ft-actions">
        <a class="ft-pill" href={linkWithLineSmallLink}>
          Start a project
          <svg viewBox="0 0 20 12" aria-hidden="true"><path d="M0 6h18M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        </a>
        <a class="ft-pill" href="mailto:hello@magiapix.com">
          Drop us an email
          <span aria-hidden="true">@</span>
        </a>
      </div>
    </div>
    <ul class="ft-social">
      {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
    </ul>
  </div>

  <div class="ft-mark" aria-hidden="true"><span>MAGIAPIX</span></div>

  <div class="ft-meta">
    <p>© 2026 Magiapix Agency — 18-22 Corsham St, Hoxton, London N1 6DR, UK — <a href="mailto:hello@magiapix.com">hello@magiapix.com</a></p>
  </div>
</footer>

<style>
  .ft {
    --ft-pad: clamp(15px, 1.25vw, 24px);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vw, 120px);
    width: 100%;
    /* height follows the content: a full-screen min-height left a screen-tall gap above the wordmark on tall screens */
    padding: clamp(90px, 7vw, 130px) var(--ft-pad) var(--ft-pad);
    background: #000;
    color: #fff;
    font-family: "Zalando Sans Variable", "Zalando Sans Variable Placeholder", sans-serif;
  }
  .ft a { color: inherit; text-decoration: none; }

  /* tablet and desktop: socials on the left, headline and pills on the right (phone keeps headline first) */
  .ft-top {
    display: flex;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }
  .ft-head {
    margin: 0;
    font-size: clamp(48px, 6.25vw, 120px);
    font-weight: 800;
    font-variation-settings: "wght" 800;
    line-height: .95;
    letter-spacing: -.035em;
  }
  .ft-accent { color: var(--color-accent, #9d8cff); }

  .ft-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(28px, 2.2vw, 40px);
  }
  .ft-pill {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 20px 26px;
    border: 1px solid rgba(255, 255, 255, .45);
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: .02em;
    text-transform: uppercase;
    transition: border-color .2s, color .2s;
  }
  .ft-pill:hover { border-color: var(--color-accent, #9d8cff); color: var(--color-accent, #9d8cff); }
  .ft-pill svg { width: 20px; height: 12px; }

  .ft-social {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: clamp(22px, 1.7vw, 32px);
    line-height: 1.15;
    letter-spacing: -.01em;
  }
  .ft-social a:hover { color: var(--color-accent, #9d8cff); }

  /* wordmark: the text is ~4.82em wide, so the font size is the box width over that */
  .ft-mark {
    margin-top: clamp(0px, 4vw, 80px);
    container-type: inline-size;
    line-height: 0;
    opacity: .2; /* faded like the vertical section titles (.heading-faded) */
  }
  .ft-mark span {
    display: block;
    font-size: calc(100cqw / 4.82);
    font-weight: 900;
    font-variation-settings: "wght" 900;
    line-height: .78;
    letter-spacing: -.045em;
    white-space: nowrap;
  }

  .ft-meta {
    display: flex;
    justify-content: center;
    text-align: center;
    font-size: 14px;
  }
  .ft-meta p { margin: 0; }
  .ft-meta a:hover { color: var(--color-accent, #9d8cff); }

  /* phone: one centred column */
  @media (max-width: 809.98px) {
    .ft { text-align: center; }
    .ft-top { flex-direction: column; align-items: center; }
    .ft-actions { justify-content: center; }
    .ft-pill { padding: 16px 20px; font-size: 13px; }
    .ft-meta { font-size: 12px; }
  }
</style>
