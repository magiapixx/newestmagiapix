---
// Footer - Section: plain black, no background effects. Headline + two pill buttons and a social column on top,
// a big ice7 wordmark, then a centred one-line meta bar (copyright, address, email)
interface Props {
  linkWithLineSmallLink: string;
}

const { linkWithLineSmallLink } = Astro.props;

const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/' },
  { label: 'Instagram', href: 'https://www.instagram.com/' },
  { label: 'Behance', href: 'https://www.behance.net/' },
  { label: 'X', href: 'https://x.com/' },
  { label: 'WhatsApp', href: 'https://wa.me/' },
];
---

<footer class="ft">
  <div class="ft-top">
    <div class="ft-lead">
      <h2 class="ft-head">Come say<br />hello<span class="ft-accent">.</span></h2>
      <div class="ft-actions">
        <a class="ft-pill" href={linkWithLineSmallLink}>
          Start a project
          <svg viewBox="0 0 20 12" aria-hidden="true"><path d="M0 6h18M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        </a>
        <a class="ft-pill" href="mailto:hello@magiapix.com">
          Drop us an email
          <span aria-hidden="true">@</span>
        </a>
      </div>
    </div>
    <ul class="ft-social">
      {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
    </ul>
  </div>

  <div class="ft-mark" aria-hidden="true"><span>ICE 7<span class="ft-mark-tail"> STUDIO</span></span></div>

  <div class="ft-meta">
    <p>© 2026 Magiapix Agency — 18-22 Corsham St, Hoxton, London N1 6DR, UK — <a href="mailto:hello@magiapix.com">hello@magiapix.com</a></p>
  </div>
</footer>

<style>
  .ft {
    --ft-pad: clamp(15px, 1.25vw, 24px);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vw, 120px);
    width: 100%;
    /* height follows the content: a full-screen min-height left a screen-tall gap above the wordmark on tall screens */
    padding: clamp(90px, 7vw, 130px) var(--ft-pad) var(--ft-pad);
    background: #000;
    color: #fff;
    font-family: "Zalando Sans Variable", "Zalando Sans Variable Placeholder", sans-serif;
  }
  .ft a { color: inherit; text-decoration: none; }

  /* tablet and desktop: socials on the left, headline and pills on the right (phone keeps headline first) */
  .ft-top {
    display: flex;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }
  .ft-head {
    margin: 0;
    font-size: clamp(48px, 6.25vw, 120px);
    font-weight: 400;
    font-variation-settings: "wght" 400;
    line-height: 1;
    letter-spacing: -.03em;
  }
  .ft-accent { color: var(--color-accent, #9d8cff); }

  .ft-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(28px, 2.2vw, 40px);
  }
  /* buttons match the blog CTA: square, monospace caps, the first solid white and the second outlined */
  .ft-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
    border: 1px solid rgba(255, 255, 255, .5);
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 14px;
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color .25s, color .25s, border-color .25s;
  }
  /* .ft prefix: outranks `.ft a { color: inherit }` */
  .ft .ft-pill:first-child { background: #fff; border-color: #fff; color: #000; }
  .ft .ft-pill:hover, .ft .ft-pill:focus-visible { background: #fff; border-color: #fff; color: #000; }
  .ft .ft-pill:first-child:hover, .ft .ft-pill:first-child:focus-visible { background: var(--color-accent, #9d8cff); border-color: var(--color-accent, #9d8cff); }
  .ft-pill:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .ft-pill svg { width: 16px; height: 10px; }

  .ft-social {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: calc(clamp(22px, 1.7vw, 32px) * .7);
    line-height: 1.15;
    letter-spacing: -.01em;
  }
  .ft-social a:hover { color: var(--color-accent, #9d8cff); }

  /* wordmark: ICE 7 is ~2.33em wide at this weight, so box width / 2.36em fills the width with a hair to spare */
  .ft-mark {
    color: var(--color-accent, #9d8cff);
    margin-top: clamp(0px, 4vw, 80px);
    container-type: inline-size;
    line-height: 0;
  }
  .ft-mark > span {
    display: block;
    font-size: calc(100cqw / 2.36);
    font-weight: 900;
    font-variation-settings: "wght" 900;
    line-height: .78;
    letter-spacing: -.045em;
    white-space: nowrap;
  }
  /* tablet and desktop add the studio name, in the same heavy weight, and the whole line is sized down to fill
     the width (ICE 7 STUDIO is ~6.09em wide) */
  /* ICE 7 in the accent, STUDIO in white */
  .ft-mark-tail { display: none; color: #fff; }
  @media (min-width: 810px) {
    .ft-mark-tail { display: inline; }
    .ft-mark > span { font-size: calc(100cqw / 6.15); }
  }

  .ft-meta {
    display: flex;
    justify-content: center;
    text-align: center;
    font-size: 14px;
  }
  /* sits close under the wordmark: cancel most of the footer's column gap */
  .ft-mark + .ft-meta { margin-top: calc(24px - clamp(40px, 6vw, 120px)); }
  .ft-meta p { margin: 0; }
  .ft-meta a:hover { color: var(--color-accent, #9d8cff); }

  /* phone: left-aligned column, pills stacked, socials centred over the 7 of ICE 7 (its middle sits at ~86.2% of
     the width at every phone size, since the wordmark scales with it); the meta line stays centred */
  @media (max-width: 809.98px) {
    .ft-top { flex-direction: column; align-items: stretch; gap: 50px; }
    .ft-actions { flex-direction: column; align-items: stretch; width: 100%; max-width: 320px; }
    .ft-pill { justify-content: center; }
    .ft-social { align-self: flex-start; width: max-content; margin-left: 86.2%; transform: translateX(-50%); }
    .ft-meta { font-size: 12px; }
  }
</style>
