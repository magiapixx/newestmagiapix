type Name = keyof typeof DEFS;

interface Props {
  variant?: Name;
  variants?: PerBp<Name>;
  first?: string;
  style?: string;
  /** extra classes on the root, e.g. a breakpoint-only utility like fill-width-phone */
  extraClass?: string;
}

const { variant = "Scroll Down - H6", variants, first, style, extraClass } = Astro.props;
const map: PerBp<Name> = variants ?? { p: variant, t: variant, lg: variant, xl: variant };

// the colour a line resolves to: its --m-text-color points at a custom property its wrapper sets
const color = (l: Line) => {
  const m = l.hStyle.match(/--m-text-color:var\((--[\w-]+), (.*)\)$/);
  if (!m) return l.hStyle;
  const own = l.style.match(new RegExp(m[1] + ":([^;]+)"));
  return own ? own[1] : m[2];
};
const shape = (n: Name) => {
  const def: Def = DEFS[n];
  return JSON.stringify([style !== undefined && def.acceptsStyle, def.lines.map((l) => [l.cls, l.text ?? first, color(l)])]);
};
// one element is enough when every breakpoint has the same lines, text and colours (only sizes differ)
const merged = BPS.every((b) => shape(map[b]) === shape(map.lg));
const base: Def = DEFS[map.lg];
const typeAt = (i: number) => rv(Object.fromEntries(BPS.map((b) => [b, (DEFS[map[b]] as Def).lines[i].type])) as PerBp<string>);
const copies = merged
  ? []
  : [...new Set(groups(map).map(([, name]) => name))].map((name) => ({
      def: DEFS[name] as Def,
      hide: hideWhere(Object.fromEntries(BPS.map((b) => [b, map[b] === name])) as PerBp<boolean>),
    }));
---

{
  merged ? (
    <div class:list={[ROOT, extraClass, rv(Object.fromEntries(BPS.map((b) => [b, (DEFS[map[b]] as Def).cls])) as PerBp<string>)]} style={base.acceptsStyle ? style : undefined}
      >{base.lines.map((l, i) => { const Tag = l.tag; return (<div class={l.cls} style={l.style}><Tag class={`rt ${typeAt(i)}`} dir="auto" style={l.hStyle}>{l.text ?? first}</Tag></div>); })}</div>
  ) : (
    copies.map(({ def, hide }) => (
      <div class:list={[ROOT, def.cls, extraClass, hide]} style={def.acceptsStyle ? style : undefined}
        >{def.lines.map((l) => { const Tag = l.tag; return (<div class={l.cls} style={l.style}><Tag class={`rt ${l.type}`} dir="auto" style={l.hStyle}>{l.text ?? first}</Tag></div>); })}</div>
    ))
  )
}
