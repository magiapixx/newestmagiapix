const root = rv({ lg: 'v-rlzhcv', xl: 'v-gzk4hp', t: 'v-10yn8j3', p: 'v-bdsxbs' });
---

<header class:list={["m-JHNch m-rlzhcv", root]} style="background-color:var(--color-black, rgb(0, 0, 0));height:100%;width:100%"
  ><div class="m-4vg42g"
    ><div class="m-1vf98m7-container"
      ><div style="position:relative;width:100%;height:100%;overflow:hidden;background:#050505"
        ><canvas style="position:absolute;inset:0;width:100%;height:100%;display:block" data-gl="luma" data-images="/images/ZQqfSSYOzv1ENV9pRRJHAAy691Y.jpg,/images/83asOi3fwykzrvHg1eZXJiySeHc.jpg"></canvas
      ></div
    ></div
  ></div
  ><div class="m-ktpkvy"
    ><div class="m-9l4w1o"
      ><div class="m-1dwph83-container" data-fit-title
        ><HeadingsVertical variants={{ lg: "Cases - H1", xl: "Cases - H1 Big", t: "Cases - H1", p: "Cases - H2" }} first="Cases"></HeadingsVertical
      ></div
    ></div
    ><div class="m-1cpnmm7 hide-phone"></div
    ><div class="m-dqakio"
      ><div class="m-1cuvaoo-container"
        ><HeadingsVertical variants={{ lg: "Scroll Down - H6", xl: "Scroll Down - H6", t: "Scroll Down - H6", p: "Scroll Down - H6 - Smaller" }} extraClass="heading-faded"></HeadingsVertical
