---
// Demo 5 - Cases
import HeadingsVertical from './HeadingsVertical.astro';
import LinkWithLine from './LinkWithLine.astro';
import Navigation from './Navigation.astro';
import PlusSmall from './PlusSmall.astro';
import PrevNext from './PrevNext.astro';
import { rv } from '../lib/rv';

interface Props {
  dataSrc: string;
  text: string;
  image1Image: { src?: string; srcset?: string; width?: string; height?: string };
  hasMainInfo?: boolean;
  mainInfoClass?: string;
  client: string;
  yearDatetime: string;
  year: string;
  services: string;
  image2Style: string;
  image2Image: { src?: string; srcset?: string; width?: string; height?: string };
  image3Image: { src?: string; srcset?: string; width?: string; height?: string };
  image4Image: { src?: string; srcset?: string; width?: string; height?: string };
  hasBlock?: boolean;
  hasImages?: boolean;
  prevNextLink?: string;
  prevNextDataSrc?: string;
  prevNextText?: string;
  prevNextLink2?: string;
  prevNextDataSrc2?: string;
  prevNextText2?: string;
  hasImages2?: boolean;
}

const { dataSrc, text, image1Image, hasMainInfo, mainInfoClass, client, yearDatetime, year, services, image2Style, image2Image, image3Image, image4Image, hasBlock, hasImages, prevNextLink, prevNextDataSrc, prevNextText, prevNextLink2, prevNextDataSrc2, prevNextText2, hasImages2 } = Astro.props;
// the text styles each breakpoint copy used (lib/rv)
const titleType = rv({ lg: 'type-1m33n2m', xl: 'type-1m33n2m', t: 'type-4dgq3i', p: 'type-9iwysc' });
const detailType = rv({ lg: 'type-1qeok15', xl: 'type-1qeok15', t: 'type-1qeok15', p: 'type-1xxob9n' });
const labelType = rv({ lg: 'type-1xxob9n', xl: 'type-1xxob9n', t: 'type-y2tuor', p: 'type-y2tuor' });
---

<div class="m-WvFza m-go5UE m-kXq9A m-OjHb3 m-xbhBc m-3UBND m-5BKxZ m-dS8v4 m-lfu50q" style="min-height:100vh;width:auto;display:contents"
  ><header class="m-1fyxjp7"
    ><div class="m-8qypjc-container"
      ><div style="height:100%;width:100%;position:relative;overflow:hidden;background:rgb(0, 0, 0)" data-gl="distortion" data-src={dataSrc}></div
    ></div
    ><div class="m-1twt0io"
      ><div class="m-hmh9nl"
        ><div class="m-123yh8n" style="transform:none"
          ><h1 class={`rt ${titleType}`} dir="auto" style="--m-text-color:var(--color-white, rgb(255, 255, 255))">{text}</h1
        ></div
      ></div
      ><div class="m-1fchig9"
        ><div class="m-154um70-container"
          ><HeadingsVertical variants={{ lg: "Scroll Down - H6", xl: "Scroll Down - H6", t: "Scroll Down - H6", p: "Scroll Down - H6 - Smaller" }}></HeadingsVertical
        ></div
      ></div
    ></div
  ></header
  ><section class="m-1ecrof8"
    ><div class="m-8hjrja"
      ><div class="m-19nb3ke"
        ><div class="m-1jv4fgz"
          ><div class="bp"
            ><div class="m-1wfvbrh" style="will-change:transform;height:auto;aspect-ratio:1.7777777777777777;opacity:0;transform:none" data-reveal="{&quot;from&quot;:{&quot;opacity&quot;:0},&quot;transition&quot;:{&quot;bounce&quot;:0,&quot;delay&quot;:0,&quot;duration&quot;:0.5,&quot;type&quot;:&quot;spring&quot;},&quot;threshold&quot;:0}"
              ><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0"
                ><img decoding="async" loading="lazy" width={image1Image.width} height={image1Image.height} sizes="(min-width: 1200px) calc(max((min(100vw - 40px, 1920px) - 110px) / 8, 50px) * 6 + 50px), (max-width: 809.98px) calc(min(100vw - 40px, 1920px) - 30px), (min-width: 810px) and (max-width: 1199.98px) calc(max((min(100vw - 40px, 1920px) - 110px) / 8, 50px) * 8 + 70px)" srcset={image1Image.srcset} src={image1Image.src} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"
              ></div
            ></div
          ></div
        ></div
        ><div class="m-6f8sen"
          ><div class="m-1t6ky8k" style="transform:none"
            ><p class="rt type-y2tuor" dir="auto">To align the brand’s long-term strategy with a solid digital concept, we needed to balance ambition with clarity. The challenge was to create a flexible foundation that supports growth while ensuring the messaging remains focused and easy to grasp.</p
          ></div
          ><div class="m-3l1cmk"></div
          ><div class="m-kw7g2w">{hasMainInfo && (<Fragment><div class="bp"
              ><div class="m-1jvqs3j-container"
                ><LinkWithLine link="#" target="_blank" text="Open Website"></LinkWithLine
              ></div
            ></div></Fragment>)}<div class:list={["m-b7pr7s hide-tablet", mainInfoClass]}></div
            ><div class="m-jlzu5d"
              ><div class="m-17vrhn6"
                ><div class="m-wbazjm" style="transform:none"
                  ><p class="rt type-54rzwz" dir="auto" style="--m-text-color:var(--color-white, rgb(255, 255, 255))">Client</p
                ></div
                ><div class="m-1na3axd" style="transform:none"
                  ><h5 class={`rt ${detailType}`} dir="auto" style="--m-text-color:var(--color-white, rgb(255, 255, 255))">{client}</h5
                ></div
              ></div
              ><div class="m-4l438k"
                ><div class="m-mxblt9" style="transform:none"
                  ><p class="rt type-54rzwz" dir="auto" style="--m-text-color:var(--color-white, rgb(255, 255, 255))">Year</p
                ></div
                ><div class="m-1tqx27" style="transform:none"
                  ><h5 class={`rt ${detailType}`} dir="auto" style="--m-text-color:var(--color-white, rgb(255, 255, 255))"
                  ><time datetime={yearDatetime}>{year}</time
                  ></h5
                ></div
              ></div
              ><div class="m-oxo67f"
                ><div class="m-lq9scr" style="transform:none"
                  ><p class="rt type-54rzwz" dir="auto" style="--m-text-color:var(--color-white, rgb(255, 255, 255))">Services</p
                ></div
                ><div class="m-404fjv" style="transform:none"
                  ><h5 class={`rt ${detailType}`} dir="auto" style="--m-text-color:var(--color-white, rgb(255, 255, 255))">{services}</h5
                ></div
              ></div
            ></div
          ></div
        ></div
      ></div
      ><div class="m-1pumok2"
        ><div class="bp"
          ><div class="m-1m0eall" style={image2Style} data-reveal="{&quot;from&quot;:{&quot;opacity&quot;:0},&quot;transition&quot;:{&quot;bounce&quot;:0,&quot;delay&quot;:0,&quot;duration&quot;:0.5,&quot;type&quot;:&quot;spring&quot;},&quot;threshold&quot;:0}"
            ><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0"
              ><img decoding="async" loading="lazy" width={image2Image.width} height={image2Image.height} sizes="(min-width: 1200px) calc(min(100vw - 40px, 1920px) - 40px), (min-width: 810px) and (max-width: 1199.98px) calc(min(100vw - 40px, 1920px) - 40px), (max-width: 809.98px) calc(min(100vw - 40px, 1920px) - 30px)" srcset={image2Image.srcset} src={image2Image.src} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"
            ></div
          ></div
        ></div
        ><div class="bp"
          ><div class="m-tqxf1o" style={image2Style} data-reveal="{&quot;from&quot;:{&quot;opacity&quot;:0},&quot;transition&quot;:{&quot;bounce&quot;:0,&quot;delay&quot;:0,&quot;duration&quot;:0.5,&quot;type&quot;:&quot;spring&quot;},&quot;threshold&quot;:0}"
            ><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0"
              ><img decoding="async" loading="lazy" width={image3Image.width} height={image3Image.height} sizes="(min-width: 1200px) calc(min(100vw - 40px, 1920px) - 40px), (min-width: 810px) and (max-width: 1199.98px) calc(min(100vw - 40px, 1920px) - 40px), (max-width: 809.98px) calc(min(100vw - 40px, 1920px) - 30px)" srcset={image3Image.srcset} src={image3Image.src} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"
            ></div
          ></div
        ></div
        ><div class="bp"
          ><div class="m-18bsk7p" style={image2Style} data-reveal="{&quot;from&quot;:{&quot;opacity&quot;:0},&quot;transition&quot;:{&quot;bounce&quot;:0,&quot;delay&quot;:0,&quot;duration&quot;:0.5,&quot;type&quot;:&quot;spring&quot;},&quot;threshold&quot;:0}"
            ><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0"
              ><img decoding="async" loading="lazy" width={image4Image.width} height={image4Image.height} sizes="(min-width: 1200px) calc(min(100vw - 40px, 1920px) - 40px), (min-width: 810px) and (max-width: 1199.98px) calc(min(100vw - 40px, 1920px) - 40px), (max-width: 809.98px) calc(min(100vw - 40px, 1920px) - 30px)" srcset={image4Image.srcset} src={image4Image.src} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"
            ></div
          ></div
        ></div
      ></div
    ></div
  ></section
  ><section class="m-igg6lz"
    ><div class="m-1y2qua1"
      ><div class="m-1yu9zek">{hasBlock && (<Fragment><div class="m-d55x9t" style="transform:none"
          ><h6 class={`rt ${labelType}`} dir="auto" style="--m-text-color:var(--color-accent, rgb(0, 255, 161))">Previous</h6
        ></div></Fragment>)}<div class="m-12s4iep"
          ><PlusSmall class="m-4m1mf3"></PlusSmall
          ><div class="m-7a12bb"></div
          ><PlusSmall class="m-1qvmej5"></PlusSmall
        ></div>{hasMainInfo && (<Fragment><div class="m-zv5j4s" style="transform:none"
          ><h6 class={`rt ${labelType}`} dir="auto" style="--m-text-color:var(--color-accent, rgb(0, 255, 161))">Next</h6
        ></div></Fragment>)}</div
      ><div class="m-v5e3d6">{hasImages && (<Fragment><div class="m-13j8s5i-container"
          ><PrevNext side="Right" link="/cases/montana/" dataSrc="/images/RFdcBAQsIqs2cwSENiDPQN8xt8.jpg" text="Montana"></PrevNext
        ></div></Fragment>)}{hasBlock && (<Fragment><div class="m-1pni8x8-container"
          ><PrevNext side="Left" link={prevNextLink} dataSrc={prevNextDataSrc} text={prevNextText}></PrevNext
        ></div></Fragment>)}{hasImages2 && (<Fragment><div class="m-13j8s5i-container"
          ><PrevNext side="Right" link={prevNextLink2} dataSrc={prevNextDataSrc2} text={prevNextText2}></PrevNext
        ></div></Fragment>)}</div
      ><div class="m-1wau23p"
        ><div class="m-nm3ux0"
          ><PlusSmall class="m-m6i7p6"></PlusSmall
          ><div class="m-jt6ftp"></div
          ><PlusSmall class="m-68ne1c"></PlusSmall
        ></div
      ></div
    ></div
  ></section
  ><div class="m-nmewqx-container"
    ><Navigation></Navigation
  ></div
></div>