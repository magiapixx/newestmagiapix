---
// Prices - Section
import HeadingsVertical from './HeadingsVertical.astro';
import PlusSmall from './PlusSmall.astro';
import PriceCard from './PriceCard.astro';

interface Props {
  variant?: "Desktop" | "Tablet" | "Wide" | "Phone";
  headingsVerticalVariant?: string;
  priceCardVariant?: string;
  priceCardVariant2?: string;
}

const { variant = "Desktop", headingsVerticalVariant, priceCardVariant, priceCardVariant2 } = Astro.props;

const VARIANTS = {
  "Desktop": "v-7nmgl9",
  "Tablet": "v-8657lb",
  "Wide": "v-yof8x4",
  "Phone": "v-19wxf9a",
};
---

{
  variant === "Desktop" || variant === "Tablet" || variant === "Wide" ? (
    <Fragment
      ><section class:list={["m-3R9yn m-kXq9A m-7nmgl9", VARIANTS[variant]]} style="background-color:var(--color-black, rgb(0, 0, 0));width:100%"
        ><div class="m-1gl2vdr"
          ><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0"
            ><img decoding="async" loading="lazy" width="3840" height="2160" sizes="(min-width: 1200px) and (max-width: 1599.98px) 100vw, (min-width: 810px) and (max-width: 1199.98px) 100vw, (min-width: 1600px) 100vw, (max-width: 809.98px) 100vw" srcset="/images/6xGiwso5yyR8KrBNN4ef2qnu7mI.07j9gi5.jpg 512w, /images/6xGiwso5yyR8KrBNN4ef2qnu7mI.14sj5om.jpg 1024w, /images/6xGiwso5yyR8KrBNN4ef2qnu7mI.1ujkpaj.jpg 2048w, /images/6xGiwso5yyR8KrBNN4ef2qnu7mI.0b2p83v.jpg 3840w" src="/images/6xGiwso5yyR8KrBNN4ef2qnu7mI.0b2p83v.jpg" alt="" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"
