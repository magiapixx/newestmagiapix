---
// Prices - Section: one plan at a time, picked with a tab switch. Three columns from desktop up: an example case
// study image with the plan name over it, the switch with the headline, price and two text links in the middle,
// and the plan's features (title + one line) on the right. Tablet keeps image and middle side by side with the
// features below; phones stack everything. Square corners throughout.
// The faded vertical "/The Plans" heading the other sections use stays pinned on the right; phones get the
// horizontal heading on top instead. Phone < 810px, tablet 810-1199.98px, desktop >= 1200px.
import HeadingsVertical from './HeadingsVertical.astro';
import { cases } from '../data/cases';

// each plan shows one case study image as an example of what that budget gets: `example` is a slug from data/cases.ts
const caseBySlug = Object.fromEntries(cases.map((c) => [c.slug, c]));

const plans = [
  {
    id: 'basic',
    title: 'Basic Website',
    price: '$2,500',
    example: 'montana',
    features: [
      ['Up to 5 pages', 'A focused site that covers what you do, who you are and how to reach you'],
      ['Tailored layout', 'Designed around your brand, not a template with your logo on it'],
      ['Responsive build', 'Checked on desktop, tablet and phone before launch'],
      ['CMS in Webflow or Framer', 'Edit text and images yourself, no developer needed'],
      ['Basic SEO and 2 revisions', 'Clean metadata and two rounds of refinements'],
    ],
  },
  {
    id: 'premium',
    title: 'Premium Website',
    price: '$6,000',
    example: 'armada',
    features: [
      ['Custom UI/UX, up to 12 pages', 'Every page designed for your audience and built to convert'],
      ['Design system', 'Reusable components that keep new pages consistent'],
      ['Motion and micro-interactions', 'Movement that guides the eye and gives feedback'],
      ['CMS collections and blog', 'Structured content you can grow without breaking the design'],
      ['SEO, performance and launch support', 'Fast pages, documentation and help on launch day'],
    ],
  },
  {
    id: 'awards',
    title: 'Awards Website',
    price: '$12,000',
    example: 'calderone',
    features: [
      ['Art direction and concept', 'A creative idea the whole site is built around'],
      ['WebGL, 3D and scroll storytelling', 'Bespoke visuals that turn a visit into an experience'],
      ['Custom front-end', 'Hand-built code for motion and performance no builder allows'],
      ['Sound, motion and transitions', 'Every state change designed, not left to defaults'],
      ['Award submissions and priority support', 'Entries to Awwwards, FWA and CSSDA, then priority help'],
    ],
  },
];

const mail = (subject: string) => `mailto:hello@magiapix.com?subject=${encodeURIComponent(subject)}`;
---

<section class="prices" data-prices
  ><div class="prices-heading hide-phone"
    ><div class="prices-heading-pin"
      ><HeadingsVertical first="/The Plans" variants={{ lg: "/Prices - H2", xl: "/Prices - H1", t: "/Prices - H2", p: "/Prices - H2" }} extraClass="heading-faded"></HeadingsVertical
    ></div
  ></div
  ><div class="m-1e9h1h2 prices-heading-phone hide-tablet hide-lg hide-xl" style="--extracted-a0htzi:var(--color-white, rgb(255, 255, 255));--m-link-text-color:rgb(0, 153, 255);--m-link-text-decoration:underline;transform:none"
    ><h3 class="rt type-wc4xhu section-heading" dir="auto" style="--m-text-color:var(--extracted-a0htzi, var(--color-white, rgb(255, 255, 255)))">/The Plans</h3
  ></div
  ><div class="prices-body"
    ><div class="prices-media"
      >{plans.map((plan, i) => { const img = caseBySlug[plan.example]?.props.caseStudyImage1Image; return (
        <figure class="prices-card" data-plan={plan.id} hidden={i !== 0}
          >{img && <img src={img.src} srcset={img.srcset} sizes="(min-width: 1200px) 30vw, (min-width: 810px) 45vw, 90vw" width={img.width} height={img.height} alt="" loading="lazy" decoding="async" />}
          <figcaption class="prices-card-name"><span class="prices-accent">Magiapix</span>{plan.title}</figcaption
          ><p class="prices-card-note"><span class="prices-accent">*</span> One-off project, no subscription.</p
        ></figure>
      ); })}</div
    ><div class="prices-main"
      ><div class="prices-switch" role="tablist" aria-label="Plans"
        >{plans.map((plan, i) => (
          <button class="prices-tab" type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-plan-tab={plan.id}>{plan.title.replace(' Website', '')}</button>
        ))}</div
      ><h2 class="prices-headline">Clear pricing, serious craft, no hidden fees</h2
      >{plans.map((plan, i) => (
        <div class="prices-amount-wrap" data-plan={plan.id} hidden={i !== 0}
          ><p class="prices-amount">{plan.price}<span class="prices-unit">starting at</span></p
          ><p class="prices-note"><span class="prices-accent">*</span> Final quote after a free discovery call.</p
          ><p class="prices-call">Book a short call if you want to talk the scope through first.</p
          ><p class="prices-links"><a href={mail(`${plan.title} enquiry`)}>select plan</a><a href={mail('Quick call')}>quick call</a></p
        ></div>
      ))}</div
    ><div class="prices-features"
      >{plans.map((plan, i) => (
        <ul class="prices-list" data-plan={plan.id} hidden={i !== 0}
          >{plan.features.map(([title, text]) => (
            <li><svg class="prices-check" viewBox="0 0 16 16" aria-hidden="true"><rect x=".5" y=".5" width="15" height="15" fill="none" stroke="currentColor" /><path d="M4 8.2l2.6 2.5L12 5.3" fill="none" stroke="currentColor" stroke-width="1.4" /></svg
              ><div><p class="prices-feature">{title}</p><p class="prices-feature-text">{text}</p></div></li>
          ))}</ul>
      ))}</div
  ></div
></section>

<script>
  // tab switch: show the picked plan's image, price and feature list; arrow keys move between tabs
  for (const section of document.querySelectorAll<HTMLElement>('[data-prices]')) {
    const tabs = [...section.querySelectorAll<HTMLButtonElement>('[data-plan-tab]')];
    const select = (tab: HTMLButtonElement) => {
      const id = tab.dataset.planTab;
      for (const t of tabs) t.setAttribute('aria-selected', String(t === tab));
      for (const el of section.querySelectorAll<HTMLElement>('[data-plan]')) el.hidden = el.dataset.plan !== id;
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = tabs[(i + step + tabs.length) % tabs.length];
        next.focus();
        select(next);
      });
    });
  }
</script>

<style>
  .prices {
    --gutter: 15px;
    --pad: 100px;
    --muted: rgba(255, 255, 255, .6);
    --line: var(--color-gray-850, #242424);
    --accent: var(--color-accent, rgb(157, 140, 255));
    position: relative;
    display: grid;
    gap: 60px;
    width: 100%;
    padding: var(--pad) var(--gutter);
    background: var(--color-black, #000);
    color: var(--color-white, #fff);
    font-family: "Zalando Sans Variable", "Zalando Sans Variable Placeholder", sans-serif;
    font-variation-settings: "wdth" 100, "wght" 400;
    font-size: var(--fs-0);
    line-height: 1.45;
  }
  .prices :is(h2, p, ul, figure) { margin: 0; }
  /* the three plans' panels share one cell, so the section keeps the tallest plan's height and does not jump
     when the switch changes plan; the other plans stay invisible */
  .prices [hidden] { display: revert; visibility: hidden; }
  .prices-media, .prices-features { display: grid; }
  .prices-media > *, .prices-features > * { grid-area: 1 / 1; }
  .prices-amount-wrap { grid-row: 3; grid-column: 1; }
  .prices-accent { color: var(--accent); }

  .prices-body { display: grid; gap: 100px; align-items: center; }

  /* image card: plan name top left, note bottom left */
  .prices-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 547 / 700;
    padding: 24px;
    overflow: hidden;
    background: var(--color-gray-900, #171717);
  }
  .prices-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* darken the image under the text */
  .prices-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0, 0, 0, .55), transparent 35%, transparent 70%, rgba(0, 0, 0, .55));
  }
  .prices-card > :not(img) { position: relative; z-index: 1; }
  .prices-card-name { display: grid; font-size: var(--fs-2); line-height: 1.1; letter-spacing: -.02em; }
  .prices-card-name .prices-accent { font-size: var(--fs-0); letter-spacing: 0; }
  .prices-card-note { font-size: var(--fs--1); }

  /* middle: switch, headline, price, links */
  .prices-main { display: grid; justify-items: center; gap: 72px; text-align: center; }
  .prices-switch { display: inline-flex; border: 1px solid rgba(255, 255, 255, .5); }
  .prices-tab {
    padding: 12px 20px;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-variation-settings: "wdth" 100, "wght" 500;
    cursor: pointer;
    transition: background-color .25s, color .25s;
  }
  .prices-tab[aria-selected="true"] { background: var(--color-white, #fff); color: var(--color-black, #000); }
  .prices-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .prices-headline {
    max-width: 13em;
    color: var(--muted);
    font-size: var(--fs-4);
    font-weight: 500;
    font-variation-settings: "wdth" 100, "wght" 500;
    line-height: 1.08;
    letter-spacing: -.04em;
  }
  .prices-amount-wrap { display: grid; justify-items: center; gap: 24px; }
  .prices-amount {
    position: relative;
    font-size: var(--fs-6);
    font-weight: 800;
    font-variation-settings: "wdth" 100, "wght" 800;
    line-height: 1;
    letter-spacing: -.05em;
    font-variant-numeric: tabular-nums;
  }
  .prices-unit {
    position: absolute;
    top: .2em;
    left: 100%;
    margin-left: 8px;
    font-size: var(--fs--1);
    font-weight: 400;
    font-variation-settings: "wdth" 100, "wght" 400;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .prices-note { color: var(--muted); font-size: var(--fs--1); }
  .prices-call { max-width: 20em; margin-top: 48px !important; color: var(--muted); font-size: var(--fs-1); line-height: 1.3; }
  .prices-links { display: flex; gap: 48px; margin-top: 48px !important; font-size: var(--fs-2); }
  .prices-links a { color: inherit; text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .prices-links a:hover, .prices-links a:focus-visible { color: var(--accent); }

  /* features: square check, title, one line, hairline under each */
  .prices-list { display: grid; padding: 0; list-style: none; }
  .prices-list li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 36px;
    padding: 36px 0;
    border-bottom: 1px solid var(--line);
  }
  .prices-check { width: 16px; height: 16px; margin-top: 5px; color: var(--accent); }
  .prices-feature { font-size: var(--fs-1); line-height: 1.25; letter-spacing: -.02em; }
  .prices-feature-text { margin-top: 6px !important; color: var(--muted); font-size: var(--fs--1); line-height: 1.5; }

  @media (min-width: 810px) {
    .prices { --gutter: 20px; --pad: 160px; grid-template-columns: 1fr auto; column-gap: 40px; }
    .prices-body { grid-column: 1; grid-row: 1; grid-template-columns: 1fr 1fr; column-gap: 80px; }
    .prices-heading { grid-column: 2; grid-row: 1; }
    .prices-heading-pin { position: sticky; top: 100px; }
    .prices-features { grid-column: 1 / -1; }
  }

  @media (min-width: 1200px) {
    /* one screen tall, content centred in it; the gaps are twice the reference's */
    .prices { --pad: 60px; min-height: calc(100vh / var(--z, 1)); align-content: stretch; }
    .prices-body { align-self: center; }
    /* the vertical heading must not set the height: it takes no room of its own and is sized to the screen,
       like the Industries heading */
    .prices-heading { height: 0; min-height: 100%; align-self: stretch; }
    .prices-heading :global(.m-v0AUC .rt) {
      --m-font-size: min(var(--fs-8), calc((calc(100vh / var(--z, 1)) - 150px) / 4.1)) !important;
    }
    /* reference widths: image 547, middle ~620, features 350 */
    .prices-body { grid-template-columns: 547fr 620fr 350fr; column-gap: 100px; }
    .prices-features { grid-column: auto; }
    /* one step smaller than tablet so the tallest feature list still fits one screen on 900px-tall desktops */
    .prices-feature { font-size: var(--fs-0); }
  }
</style>
