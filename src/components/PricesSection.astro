          ></div
        ></div
        ><div class="m-1lur3i6"
          ><div class="m-mpy07n-container"
            ><HeadingsVertical first="/Prices" variant={headingsVerticalVariant}></HeadingsVertical
          ></div
          ><div class="m-a4iadk"></div
          ><div class="m-1rwo6qr"
            ><div class="m-hcyrer-container" style="will-change:transform;opacity:0.5;transform:translateY(100px)" data-reveal="{&quot;from&quot;:{&quot;opacity&quot;:0.5,&quot;y&quot;:100},&quot;transition&quot;:{&quot;bounce&quot;:0,&quot;delay&quot;:0,&quot;duration&quot;:0.8,&quot;type&quot;:&quot;spring&quot;},&quot;threshold&quot;:0}"
              ><PriceCard variant={priceCardVariant}></PriceCard
            ></div
            ><div class="m-2fldc8-container" style="will-change:transform;opacity:0.5;transform:translateY(100px)" data-reveal="{&quot;from&quot;:{&quot;opacity&quot;:0.5,&quot;y&quot;:100},&quot;transition&quot;:{&quot;bounce&quot;:0,&quot;delay&quot;:0,&quot;duration&quot;:0.8,&quot;type&quot;:&quot;spring&quot;},&quot;threshold&quot;:0}"
