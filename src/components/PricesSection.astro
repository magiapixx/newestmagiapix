---
// Prices - Section: three website packages as rows, after the Vucko services list. Each row is an example case
// study image (ImageOpening: the black curtain slides off as it scrolls in, like the service images), a bordered
// panel with the package name and a short description, and a narrow vertical "[See example]" tab; the image
// switches sides on every second row. Square corners throughout. Proportions follow the reference: image 637,
// panel 758, tab 118, 4px apart, image 637 x 237.
// The faded vertical "/The Plans" heading the other sections use stays pinned on the right; phones get the
// horizontal heading on top instead. Phone < 810px, tablet 810-1199.98px, desktop >= 1200px.
import HeadingsVertical from './HeadingsVertical.astro';
import ImageOpening from './ImageOpening.astro';
import { cases } from '../data/cases';

// each package shows one case study as an example of what that budget gets: set `example` to a slug from data/cases.ts
const caseBySlug = Object.fromEntries(cases.map((c) => [c.slug, c]));

const plans = [
  {
    title: 'Basic Website',
    description: 'A clean, credible site to get online fast. Up to five pages, a layout tailored to your brand and a CMS you can edit yourself.',
    example: 'montana',
  },
  {
    title: 'Premium Website',
    description: 'A fully custom site built to convert. Bespoke UI/UX, a reusable design system, motion and a CMS-driven blog.',
    example: 'armada',
  },
  {
    title: 'Awards Website',
    description: 'An award-level experience people remember. Art direction, WebGL and 3D, scroll storytelling and custom front-end.',
    example: 'calderone',
  },
];
---

<section class="prices"
  ><div class="prices-heading hide-phone"
    ><div class="prices-heading-pin"
      ><HeadingsVertical first="/The Plans" variants={{ lg: "/Prices - H2", xl: "/Prices - H1", t: "/Prices - H2", p: "/Prices - H2" }} extraClass="heading-faded"></HeadingsVertical
    ></div
  ></div
  ><div class="m-1e9h1h2 prices-heading-phone hide-tablet hide-lg hide-xl" style="--extracted-a0htzi:var(--color-white, rgb(255, 255, 255));--m-link-text-color:rgb(0, 153, 255);--m-link-text-decoration:underline;transform:none"
    ><h3 class="rt type-wc4xhu section-heading" dir="auto" style="--m-text-color:var(--extracted-a0htzi, var(--color-white, rgb(255, 255, 255)))">/The Plans</h3
  ></div
  ><div class="prices-rows"
    >{plans.map((plan, i) => { const ex = caseBySlug[plan.example]; const img = ex?.props.caseStudyImage1Image; return (
      <article class:list={["prices-card", { "is-flipped": i % 2 === 1 }]}
        >{ex && img && (
          <a class="prices-example" href={`/cases/${ex.slug}/`} aria-label={`Example: ${ex.title} case study`}
            ><ImageOpening image={img} curtain="var(--color-black, rgb(0, 0, 0))"></ImageOpening
          ></a>
        )}<div class="prices-panel"
          ><h3 class="prices-title">{plan.title}</h3
          ><p class="prices-desc">{plan.description}</p
        ></div
        >{ex && (
          <a class="prices-tab" href={`/cases/${ex.slug}/`} aria-label={`See the ${ex.title} case study`}><span>[See example]</span></a>
        )}</article
    >); })}</div
></section>

<style>
  .prices {
    --gutter: 15px;
    --pad: 100px;
    --muted: rgba(255, 255, 255, .6);
    --line: var(--color-gray-850, #242424);
    --mono: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    position: relative;
    display: grid;
    gap: 60px;
    width: 100%;
    padding: var(--pad) var(--gutter);
    background: var(--color-black, #000);
    color: var(--color-white, #fff);
    font-family: "Zalando Sans Variable", "Zalando Sans Variable Placeholder", sans-serif;
    font-variation-settings: "wdth" 100, "wght" 350;
    font-size: var(--fs-0);
    line-height: 1.45;
  }
  .prices :is(h3, p) { margin: 0; }

  /* rows of three square-cornered blocks: image, bordered text panel and a narrow "[See example]" tab.
     Phones stack them; from tablet up they sit side by side and every second row puts the image on the right */
  .prices-rows { display: grid; gap: 4px; }
  .prices-card {
    display: grid;
    grid-template-areas: "image" "panel" "tab";
    gap: 4px;
  }

  /* ImageOpening sets its own width and aspect ratio inline; here it fills the image cell instead */
  .prices-example { grid-area: image; display: block; aspect-ratio: 16 / 9; overflow: hidden; }
  .prices-example :global(.m-1K3ma) { width: 100% !important; height: 100% !important; aspect-ratio: auto !important; }

  .prices-panel {
    grid-area: panel;
    display: grid;
    gap: 24px;
    align-content: center;
    padding: 40px 24px;
    border: 1px solid var(--line);
    background: var(--color-gray-900, #171717);
  }
  .prices-title {
    font-family: var(--mono);
    font-size: var(--fs-2);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .prices-desc { max-width: 40em; color: var(--muted); line-height: 1.6; }

  .prices-tab {
    grid-area: tab;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    border: 1px solid var(--line);
    color: inherit;
    font-family: var(--mono);
    font-size: var(--fs--1);
    font-weight: 700;
    letter-spacing: .2em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color .3s ease, color .3s ease;
  }
  .prices-tab:hover, .prices-tab:focus-visible { background: var(--color-white, #fff); color: var(--color-black, #000); }

  @media (min-width: 810px) {
    .prices { --gutter: 20px; --pad: 160px; grid-template-columns: 1fr auto; column-gap: 40px; }
    .prices-rows { grid-column: 1; grid-row: 1; }
    .prices-heading { grid-column: 2; grid-row: 1; }
    .prices-heading-pin { position: sticky; top: 100px; }
    /* reference widths 637 / 758 / 118; the image is 637 x 237 and sets the row height */
    .prices-card {
      grid-template-columns: 637fr 758fr 118fr;
      grid-template-areas: "image panel tab";
      /* row height of the reference: 237 for a 637 + 758 + 118 row (gaps excluded); grows only if the text needs more */
      grid-template-rows: minmax(calc((100cqw - 8px) * 237 / 1513), auto);
    }
    /* align-content: start, or the rows stretch to the height of the tall vertical heading beside them */
    .prices-rows { container-type: inline-size; align-content: start; }
    .prices-card.is-flipped {
      grid-template-columns: 758fr 637fr 118fr;
      grid-template-areas: "panel image tab";
    }
    /* the image takes no room of its own: it fills whatever height the row gets */
    .prices-example { position: relative; aspect-ratio: auto; }
    .prices-example :global(.m-1K3ma) { position: absolute !important; inset: 0; }
    .prices-panel { padding: 30px 40px; gap: 20px; }
    .prices-tab { padding: 20px 0; }
    .prices-tab span { writing-mode: vertical-rl; transform: rotate(180deg); }
  }

  @media (min-width: 1200px) {
    .prices { --pad: 240px; }
    .prices-panel { padding: 40px 60px; }
    .prices-title { font-size: var(--fs-3); }
  }
</style>
