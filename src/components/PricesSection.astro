                ><PlusSmall class="m-sehlle" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusSmall
                ><div class="m-ktclx4" style="background-color:var(--color-white, rgb(255, 255, 255));opacity:0.2"></div
                ><PlusSmall class="m-1qktt0u" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusSmall
              ></div
            ></div
            ><div class="m-jaxlce-container" style="will-change:transform;opacity:0.5;transform:translateY(100px)" data-reveal="{&quot;from&quot;:{&quot;opacity&quot;:0.5,&quot;y&quot;:100},&quot;transition&quot;:{&quot;bounce&quot;:0,&quot;delay&quot;:0,&quot;duration&quot;:0.8,&quot;type&quot;:&quot;spring&quot;},&quot;threshold&quot;:0}"
