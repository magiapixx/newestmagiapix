---
// Why Us - Section (was Subscription): one markup for every breakpoint (lib/rv)
import AccentSweep from './AccentSweep.astro';
import HeadingsVertical from './HeadingsVertical.astro';
import { rv } from '../lib/rv';

const look = rv({ lg: 'v-r3folb', xl: 'v-ffyfvy', t: 'v-14dwyd8', p: 'v-vz0dz5' });
const intro = rv({ lg: 'type-1qeok15', xl: 'type-1qeok15', t: 'type-1qeok15', p: 'type-1xxob9n' });

// Cards alternate left / right down the column, like the original zigzag
const cards = [
  { tag: 'Pricing', title: 'Transparent Pricing', text: 'One monthly rate. The number you see is the number you pay.', icon: '/images/xlnhAUAgwVLAHsDEHaP3Ekg9GCw.19j17m1.svg' },
  { tag: 'Process', title: 'Refined Until Right', text: "We revise until it's right, not until the hours run out.", icon: '/images/rnOcaRBsZ0SaJdqUEdnGXgS0es.19j17m1.svg' },
  { tag: 'Speed', title: 'Fast Delivery', text: 'First designs in days, not weeks. Speed comes from focus, never from shortcuts.', icon: '/images/qwlHpkDerF2goQGHVw22KCquy0.19j17m1.svg' },
  { tag: 'Team', title: 'Senior Expertise', text: 'The people you meet are the people who design. No hand-offs to juniors.', icon: '/images/2GhbTUuLsZiZnefO07P0cTksQ.19j17m1.svg' },
];
const total = String(cards.length).padStart(2, '0');
const reveal = JSON.stringify({ from: { opacity: 0.3, y: 100 }, transition: { bounce: 0, delay: 0, duration: 1, type: 'spring' }, threshold: 0 });
---

<section class:list={["m-5AYrz m-5BKxZ m-dS8v4 m-OjHb3 m-lhYZM m-r3folb", look]} style="background-color:var(--color-black, rgb(0, 0, 0));width:100%"
  ><div class="m-19sddme"
    ><div class="m-7fgkm7-container hide-phone"
      ><HeadingsVertical first="/Why Us" variants={{ lg: "/Prices - H1", xl: "/Prices - H1", t: "/Prices - H2", p: "/Prices - H1" }} extraClass="heading-faded"></HeadingsVertical
    ></div
    ><div class="m-199ljbk hide-phone"></div
    ><div class="m-1ljqxg9"
      ><div class="m-rzy58b" data-scramble="sweep" style="--extracted-1lwpl3i:var(--color-white, rgb(255, 255, 255));--extracted-as4nhg:var(--color-accent, rgb(0, 255, 161));--m-paragraph-spacing:0px;--extracted-1vqrutl:var(--color-accent, rgb(0, 255, 161));--extracted-1w1cjl5:var(--color-white, rgb(255, 255, 255));transform:none"
        ><AccentSweep></AccentSweep
        ><h5 class={`rt ${intro}`} dir="auto" style="--m-text-color:var(--extracted-1lwpl3i, var(--color-white, rgb(255, 255, 255)))">Not another agency. A <span class="rt" style="--m-text-color:var(--extracted-as4nhg, var(--color-accent, rgb(0, 255, 161)))">senior design team</span> on call: strategy, 3D and digital product under one roof, moving at your pace, not ours.</h5
      ></div
      ><div class="m-1knpvj9 hide-tablet hide-lg hide-xl" style="--extracted-1eung3n:var(--color-white, rgb(255, 255, 255));--m-link-text-color:rgb(0, 153, 255);--m-link-text-decoration:underline;transform:none"
        ><h4 class="rt type-9iwysc" dir="auto" style="--m-text-color:var(--extracted-1eung3n, var(--color-white, rgb(255, 255, 255)))">/Why Us</h4
      ></div
      >{cards.map((card, i) => (
        <div class:list={["wy-row", i % 2 ? "wy-right" : "wy-left"]} style="will-change:transform;opacity:0.3;transform:translateY(100px)" data-reveal={reveal}>
          <article class="wy-card">
            <header class="wy-meta">
              <span class="wy-idx">{String(i + 1).padStart(2, '0')}<span class="wy-dim">/{total}</span></span>
              <span class="wy-rule"></span>
              <span class="wy-tag">/{card.tag}</span>
            </header>
            <div class="wy-body">
              <div class="wy-icon">
                <img decoding="async" loading="lazy" width="80" height="80" src={card.icon} alt="" />
              </div>
              <div class="wy-text" style="--m-paragraph-spacing:0px">
                <h6 class="rt type-1xxob9n" dir="auto" style="--m-text-color:var(--color-white, rgb(255, 255, 255))">{card.title}</h6>
                <p class="rt type-m3s7sn" dir="auto" style="--m-text-color:rgba(255, 255, 255, 0.6)">{card.text}</p>
              </div>
            </div>
            <footer class="wy-foot"><span class="wy-bar"></span></footer>
          </article>
        </div>
      ))}</div
  ></div
></section>

<style>
  .wy-row { display: flex; width: 100%; }
  .wy-left { justify-content: flex-start; }
  .wy-right { justify-content: flex-end; }

  .wy-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 48px;
    width: 75%;
    max-width: 600px;
    padding: 28px 32px 32px;
    background: var(--color-black, #000);
    border: 1px solid var(--color-gray-850, #242424);
    transition: border-color 0.4s ease, background-color 0.4s ease;
  }
  .wy-card:hover {
    border-color: rgba(0, 255, 161, 0.35);
    background: var(--color-gray-900, #171717);
  }

  .wy-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .wy-idx { color: var(--color-accent, #00ffa1); }
  .wy-dim { color: rgba(255, 255, 255, 0.35); }
  .wy-tag { color: rgba(255, 255, 255, 0.6); }
  .wy-rule { flex: 1; height: 1px; background: var(--color-gray-850, #242424); }

  .wy-body { display: flex; align-items: flex-start; gap: 32px; }

  .wy-icon {
    position: relative;
    flex: none;
    width: 80px;
    height: 80px;
    background: var(--color-gray-900, #171717);
    border: 1px solid var(--color-gray-850, #242424);
    transition: border-color 0.4s ease, background-color 0.4s ease;
  }
  .wy-icon img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .wy-card:hover .wy-icon { border-color: var(--color-accent, #00ffa1); background: var(--color-black, #000); }

  .wy-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
    min-width: 0;
    padding-top: 6px;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .wy-text h6 { text-transform: uppercase; }

  /* progress line: accent segment fills the full width on hover */
  .wy-foot { position: relative; height: 1px; background: var(--color-gray-850, #242424); }
  .wy-bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: 15%;
    background: var(--color-accent, #00ffa1);
    transition: width 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .wy-card:hover .wy-bar { width: 100%; }

  @media (min-width: 1600px) {
    .wy-card { padding: 36px 44px 44px; gap: 60px; }
  }
  @media (min-width: 810px) and (max-width: 1199.98px) {
    .wy-card { width: 85%; max-width: 515px; padding: 24px 28px 28px; gap: 40px; }
  }
  @media (max-width: 809.98px) {
    .wy-card { width: 100%; max-width: none; padding: 20px 20px 24px; gap: 32px; }
    .wy-body { flex-direction: column; gap: 20px; }
    .wy-icon { width: 64px; height: 64px; }
    .wy-text { padding-top: 0; }
  }
  @media (hover: none) {
    .wy-bar { width: 100%; }
  }
</style>
