---
// Why Us - Section (was Subscription): one markup for every breakpoint (lib/rv)
import AccentSweep from './AccentSweep.astro';
import HeadingsVertical from './HeadingsVertical.astro';
import { rv } from '../lib/rv';

const look = rv({ lg: 'v-r3folb', xl: 'v-ffyfvy', t: 'v-14dwyd8', p: 'v-vz0dz5' });
const intro = rv({ lg: 'type-1qeok15', xl: 'type-1qeok15', t: 'type-1qeok15', p: 'type-1xxob9n' });

// What a site we build does for the client's business, as a numbered list of full-width rows like the service
// and price lists: index on the left, uppercase title in the middle, tag and muted text on the right
const cards = [
  { tag: 'Conversion', title: 'More Visitors Become Clients', text: 'Clear paths, strong calls to action and fast pages turn traffic into enquiries, sign-ups and sales.' },
  { tag: 'Branding', title: 'A Brand Image That Sticks', text: 'Type, colour and motion built around your identity, so people remember you long after they close the tab.' },
  { tag: 'Visualisation', title: 'Your Product, Made Visible', text: '3D, motion and imagery that show what you offer in seconds, not paragraphs.' },
  { tag: 'Trust', title: 'Credibility From First Click', text: 'A polished, responsive site on every screen tells clients you are serious before you say a word.' },
];
const total = String(cards.length).padStart(2, '0');
const reveal = JSON.stringify({ from: { opacity: 0.3, y: 100 }, transition: { bounce: 0, delay: 0, duration: 1, type: 'spring' }, threshold: 0 });
---

<section class:list={["m-5AYrz m-5BKxZ m-dS8v4 m-OjHb3 m-lhYZM m-r3folb", look]} style="background-color:var(--color-black, rgb(0, 0, 0));width:100%"
  ><div class="m-19sddme"
    ><div class="m-7fgkm7-container hide-phone"
      ><HeadingsVertical first="/Why Us" variants={{ lg: "/Prices - H1", xl: "/Prices - H1", t: "/Prices - H2", p: "/Prices - H1" }} extraClass="heading-faded"></HeadingsVertical
    ></div
    ><div class="m-199ljbk hide-phone"></div
    ><div class="m-1ljqxg9"
      ><div class="m-rzy58b" data-scramble="sweep" style="--extracted-1lwpl3i:var(--color-white, rgb(255, 255, 255));--extracted-as4nhg:var(--color-accent, rgb(157, 140, 255));--m-paragraph-spacing:0px;--extracted-1vqrutl:var(--color-accent, rgb(157, 140, 255));--extracted-1w1cjl5:var(--color-white, rgb(255, 255, 255));transform:none"
        ><AccentSweep></AccentSweep
        ><h5 class={`rt ${intro}`} dir="auto" style="--m-text-color:var(--extracted-1lwpl3i, var(--color-white, rgb(255, 255, 255)))">Not another agency. A <span class="rt" style="--m-text-color:var(--extracted-as4nhg, var(--color-accent, rgb(157, 140, 255)))">senior design team</span> on call: strategy, 3D and digital product under one roof, moving at your pace, not ours.</h5
      ></div
      ><div class="m-1knpvj9 hide-tablet hide-lg hide-xl" style="--extracted-1eung3n:var(--color-white, rgb(255, 255, 255));--m-link-text-color:rgb(0, 153, 255);--m-link-text-decoration:underline;transform:none"
        ><h3 class="rt type-wc4xhu section-heading" dir="auto" style="--m-text-color:var(--extracted-1eung3n, var(--color-white, rgb(255, 255, 255)))">/Why Us</h3
      ></div
      ><ol class="wy-list">{cards.map((card, i) => (
        <li class="wy-row" style="will-change:transform;opacity:0.3;transform:translateY(100px)" data-reveal={reveal}>
          <span class="wy-idx">{String(i + 1).padStart(2, '0')}<span class="wy-dim">/{total}</span></span>
          <span class="wy-tag">/{card.tag}</span>
          <h4 class="wy-title">{card.title}</h4>
          <p class="wy-text">{card.text}</p>
        </li>
      ))}</ol></div
  ></div
></section>

<style>
  /* only site tokens here: --fs-* type scale, --color-* palette, 40px row rhythm, square corners */
  .wy-list {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-white, #fff);
    font-family: "Zalando Sans Variable", "Zalando Sans Variable Placeholder", sans-serif;
  }
  .wy-row {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: "idx tag" "title title" "text text";
    gap: 20px 40px;
    padding: 40px 0;
  }

  /* labels, like the blog meta line */
  .wy-idx, .wy-tag {
    font-size: var(--fs--1);
    font-variation-settings: "wdth" 100, "wght" 535;
    line-height: 1;
    letter-spacing: .04em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .wy-idx { grid-area: idx; color: var(--color-accent, #9d8cff); }
  .wy-dim { color: rgba(255, 255, 255, .35); }
  .wy-tag { grid-area: tag; justify-self: end; color: rgba(255, 255, 255, .6); }

  /* bold uppercase title, like the price headlines */
  .wy-title {
    grid-area: title;
    margin: 0;
    font-size: var(--fs-3);
    font-weight: 700;
    font-variation-settings: "wdth" 100, "wght" 700;
    line-height: 1.1;
    letter-spacing: -.03em;
    text-transform: uppercase;
    transition: color .3s cubic-bezier(.4, 0, .2, 1);
  }
  .wy-row:hover .wy-title { color: var(--color-accent, #9d8cff); }
  .wy-text {
    grid-area: text;
    max-width: 32em;
    margin: 0;
    color: rgba(255, 255, 255, .6);
    font-size: var(--fs-0);
    font-variation-settings: "wdth" 100, "wght" 350;
    line-height: 1.45;
  }

  /* tablet and desktop: index | title | text on one line, tag above the text */
  @media (min-width: 810px) {
    .wy-row {
      grid-template-columns: 2fr 5fr 4fr;
      grid-template-areas: "idx title tag" "idx title text";
      grid-template-rows: auto 1fr;
      gap: 20px 40px;
    }
    .wy-tag { justify-self: start; }
  }
  @media (min-width: 1200px) {
    .wy-row { padding: 60px 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wy-title { transition: none; }
  }
</style>
