const look = rv({ lg: 'v-11onisr', xl: 'v-t4a0yo', t: 'v-11onisr', p: 'v-1e5q4ki' });
const textType = rv({ lg: 'type-1qeok15', xl: 'type-9iwysc', t: 'type-1qeok15', p: 'type-y2tuor' });
---

<div class:list={["m-MBJT0 m-5BKxZ m-OjHb3 m-xbhBc m-11onisr", look]} style="width:100%"
  ><div class="m-1mu2gsw"
    ><div class="m-1excjle hide-phone"
      ><div class="m-1ppt1k-container"
        ><AnimationAccent variant="v-1ejt96b" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
      ></div
      ><div class="m-10ddiy6-container"
        ><AnimationAccent variant="v-12el1mb" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
      ></div
      ><div class="m-1mvev2o-container"
        ><AnimationAccent variant="v-1hn00ti" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
      ></div
      ><div class="m-1r8cpw2-container"
        ><AnimationAccent variant="v-zdic29" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
