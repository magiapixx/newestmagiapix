---
// Text - Back Animation
import AnimationAccent from './AnimationAccent.astro';
import PlusMedium from './PlusMedium.astro';

interface Props {
  variant?: "Normal" | "H4" | "Phone";
}

const { variant = "Normal" } = Astro.props;

const VARIANTS = {
  "Normal": "v-11onisr",
  "H4": "v-t4a0yo",
  "Phone": "v-1e5q4ki",
};
---

{
  variant === "Normal" ? (
    <Fragment
      ><div class:list={["m-MBJT0 m-5BKxZ m-OjHb3 m-xbhBc m-11onisr", VARIANTS[variant]]} style="width:100%"
        ><div class="m-1mu2gsw"
          ><div class="m-1excjle"
            ><div class="m-1ppt1k-container"
              ><AnimationAccent variant="v-1ejt96b" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
            ></div
            ><div class="m-10ddiy6-container"
              ><AnimationAccent variant="v-12el1mb" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
            ></div
            ><div class="m-1mvev2o-container"
              ><AnimationAccent variant="v-1hn00ti" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
            ></div
            ><div class="m-1r8cpw2-container"
              ><AnimationAccent variant="v-zdic29" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
            ></div
          ></div
          ><div class="m-a6ig74" style="--extracted-1lwpl3i:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;transform:none"
            ><h5 class="rt type-1qeok15" dir="auto" style="--m-text-color:var(--extracted-1lwpl3i, var(--color-white, rgb(255, 255, 255)))">Fusing structural precision, modern 3D visuals, and forward-thinking digital strategy. A unique visual expression driven by the Mondra aesthetic.</h5
          ></div
          ><PlusMedium class="m-ablqfa" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusMedium
        ></div
      ></div></Fragment
    >
  ) : variant === "H4" ? (
    <Fragment
      ><div class:list={["m-MBJT0 m-5BKxZ m-OjHb3 m-xbhBc m-11onisr", VARIANTS[variant]]} style="width:100%"
        ><div class="m-1mu2gsw"
          ><div class="m-1excjle"
            ><div class="m-1ppt1k-container"
              ><AnimationAccent variant="v-1ejt96b" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
            ></div
            ><div class="m-10ddiy6-container"
              ><AnimationAccent variant="v-12el1mb" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
            ></div
            ><div class="m-1mvev2o-container"
              ><AnimationAccent variant="v-1hn00ti" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
            ></div
            ><div class="m-1r8cpw2-container"
              ><AnimationAccent variant="v-zdic29" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
            ></div
          ></div
          ><div class="m-a6ig74" style="--extracted-1lwpl3i:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;--extracted-1eung3n:var(--color-white, rgb(255, 255, 255));transform:none"
            ><h4 class="rt type-9iwysc" dir="auto" style="--m-text-color:var(--extracted-1eung3n, var(--color-white, rgb(255, 255, 255)))">Fusing structural precision, modern 3D visuals, and forward-thinking digital strategy. A unique visual expression driven by the Mondra aesthetic.</h4
          ></div
          ><PlusMedium class="m-ablqfa" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusMedium
        ></div
      ></div></Fragment
    >
  ) : variant === "Phone" ? (
    <Fragment
      ><div class:list={["m-MBJT0 m-5BKxZ m-OjHb3 m-xbhBc m-11onisr", VARIANTS[variant]]} style="width:100%"
        ><div class="m-1mu2gsw"
          ><div class="m-a6ig74" style="--extracted-1lwpl3i:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;--extracted-r6o4lv:var(--color-white, rgb(255, 255, 255));transform:none"
            ><p class="rt type-y2tuor" dir="auto" style="--m-text-color:var(--extracted-r6o4lv, var(--color-white, rgb(255, 255, 255)))">Fusing structural precision, modern 3D visuals, and forward-thinking digital strategy. A unique visual expression driven by the Mondra aesthetic.</p
          ></div
          ><PlusMedium class="m-ablqfa" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusMedium
        ></div
      ></div></Fragment
    >
  ) : null
}