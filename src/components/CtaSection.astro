---
// CTA - Section: a black band between Prices and the footer. One giant line, START A PROJECT + LET'S TALK +,
// runs to the left, and the whole band links to the contact form. Hovering turns the
// line accent and slows it down.
import PlusMedium from './PlusMedium.astro';

const words = ['Start a project', "Let's talk"];
---

<section class="cta" style="background-color:var(--color-black, rgb(0, 0, 0))"
  ><a class="cta-band" href="/about/#contact" aria-label="Start a project: get in touch"
    ><span class="cta-meta"><span>/Have a project in mind?</span><span>Get in touch</span></span
    ><span class="cta-track" aria-hidden="true"
      ><span class="cta-row"
        >{words.map((w) => (
          <span class="cta-set"><span class="cta-word">{w}</span><PlusMedium class="cta-sep" style="--mucckr:var(--color-accent, rgb(157, 140, 255))"></PlusMedium></span>
        ))}</span
    ></span
  ></a
></section>

<script>
  // Loop the row: copy its words until two widths are filled, then slide one set's width at a steady speed.
  // Hovering eases the speed down; offscreen or with reduced motion it stands still.
  const SPEED = 90; // px per second
  const HOVER = 0.25; // share of the speed while hovered
  for (const band of document.querySelectorAll<HTMLElement>('.cta-band')) {
    const track = band.querySelector<HTMLElement>('.cta-track');
    const row = band.querySelector<HTMLElement>('.cta-row');
    if (!track || !row || matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    const sets = [...row.children] as HTMLElement[];
    let loop = 0;
    let offset = 0;
    let rate = 1;
    let target = 1;
    let visible = false;
    let raf = 0;
    let last = 0;

    const measure = () => {
      row.querySelectorAll('[data-clone]').forEach((c) => c.remove());
      loop = sets.reduce((w, s) => w + s.getBoundingClientRect().width, 0);
      if (!loop) return;
      const copies = Math.ceil((track.clientWidth * 2) / loop);
      for (let c = 0; c < copies; c++) {
        for (const s of sets) {
          const clone = s.cloneNode(true) as HTMLElement;
          clone.dataset.clone = '';
          row.appendChild(clone);
        }
      }
    };
    const tick = (now: number) => {
      raf = 0;
      if (!visible) return;
      const dt = last ? Math.min((now - last) / 1000, 0.1) : 0;
      last = now;
      rate += (target - rate) * Math.min(1, dt * 4);
      offset = (offset - SPEED * rate * dt) % loop;
      row.style.transform = `translate3d(${offset}px,0,0)`;
      raf = requestAnimationFrame(tick);
    };

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !loop) measure();
      if (visible && !raf) {
        last = 0;
        raf = requestAnimationFrame(tick);
      }
    }).observe(band);
    new ResizeObserver(() => loop && measure()).observe(track);
    band.addEventListener('pointerenter', () => (target = HOVER));
    band.addEventListener('pointerleave', () => (target = 1));
    band.addEventListener('focus', () => (target = HOVER));
    band.addEventListener('blur', () => (target = 1));
  }
</script>
