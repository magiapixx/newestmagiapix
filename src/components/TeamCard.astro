const positionType = rv({ lg: 'type-y2tuor', xl: 'type-y2tuor', t: 'type-y2tuor', p: 'type-54rzwz' });
---

<div class:list={["m-sCo1m m-dS8v4 m-xbhBc m-3UBND m-16d4i2r", look]} style="background-color:var(--color-black, rgb(0, 0, 0));width:100%"
  ><div class="m-dwuqyk"
    ><div class="m-1ivvou6" draggable="false" style="height:auto;aspect-ratio:0.7963963963963964"
      ><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0"
        ><img decoding="async" loading="lazy" width="884" height="1110" sizes="(min-width: 1600px) calc(460px - 20px), (min-width: 1200px) and (max-width: 1599.98px) calc(460px - 20px), (min-width: 810px) and (max-width: 1199.98px) calc(370px - 20px), (max-width: 809.98px) calc(255px - 20px)" srcset={image.srcset} src={image.src} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover" draggable="false"
      ></div
    ></div
  ></div
  ><div class="m-3dc01a"
