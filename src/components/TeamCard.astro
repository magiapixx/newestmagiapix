---
// Team - Card: one markup for every breakpoint (lib/rv)
import { rv } from '../lib/rv';

interface Props {
  image: { src?: string; srcset?: string };
  name: string;
  position: string;
}

const { image, name, position } = Astro.props;
const look = rv({ lg: 'v-16d4i2r', xl: 'v-16d4i2r', t: 'v-1lietpk', p: 'v-ud5mqf' });
