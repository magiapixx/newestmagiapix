---
// Team - Card
import PlusSmall from './PlusSmall.astro';

interface Props {
  variant?: "Desktop" | "Tablet" | "Phone";
  image: { src?: string; srcset?: string };
  name: string;
  position: string;
}

const { variant = "Desktop", image, name, position } = Astro.props;

const VARIANTS = {
  "Desktop": "v-16d4i2r",
  "Tablet": "v-1lietpk",
  "Phone": "v-ud5mqf",
};
---

{
  variant === "Desktop" || variant === "Tablet" ? (
    <Fragment
      ><div class:list={["m-sCo1m m-dS8v4 m-xbhBc m-3UBND m-16d4i2r", VARIANTS[variant]]} style="background-color:var(--color-black, rgb(0, 0, 0));width:100%"
        ><div class="m-dwuqyk"
          ><div class="m-1ivvou6" draggable="false" style="height:auto;aspect-ratio:0.7963963963963964"
            ><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0"
              ><img decoding="async" loading="lazy" width="884" height="1110" sizes="(min-width: 1600px) calc(460px - 20px), (min-width: 1200px) and (max-width: 1599.98px) calc(460px - 20px), (min-width: 810px) and (max-width: 1199.98px) calc(370px - 20px), (max-width: 809.98px) calc(255px - 20px)" srcset={image.srcset} src={image.src} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover" draggable="false"
            ></div
          ></div
          ><PlusSmall class="m-9ygqym" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusSmall
          ><PlusSmall class="m-nz0w8o" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusSmall
          ><PlusSmall class="m-oa3lw0" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusSmall
          ><PlusSmall class="m-1ni1w4e" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusSmall
        ></div
        ><div class="m-3dc01a"
          ><div class="m-1hf4fv4" style="--extracted-1w1cjl5:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;transform:none"
            ><h6 class="rt type-1xxob9n" dir="auto" style="--m-text-color:var(--extracted-1w1cjl5, var(--color-white, rgb(255, 255, 255)))">{name}</h6
          ></div
          ><div class="m-1yd5xi8" style="--extracted-r6o4lv:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;transform:none"
            ><p class="rt type-y2tuor" dir="auto" style="--m-text-alignment:right;--m-text-color:var(--extracted-r6o4lv, var(--color-white, rgb(255, 255, 255)))">{position}</p
          ></div
        ></div
      ></div></Fragment
    >
  ) : variant === "Phone" ? (
    <Fragment
      ><div class:list={["m-sCo1m m-dS8v4 m-xbhBc m-3UBND m-16d4i2r", VARIANTS[variant]]} style="background-color:var(--color-black, rgb(0, 0, 0));width:100%"
        ><div class="m-dwuqyk"
          ><div class="m-1ivvou6" draggable="false" style="height:auto;aspect-ratio:0.7963963963963964"
            ><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0"
              ><img decoding="async" loading="lazy" width="884" height="1110" sizes="(min-width: 1600px) calc(460px - 20px), (min-width: 1200px) and (max-width: 1599.98px) calc(460px - 20px), (min-width: 810px) and (max-width: 1199.98px) calc(370px - 20px), (max-width: 809.98px) calc(255px - 20px)" srcset={image.srcset} src={image.src} alt="" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover" draggable="false"
            ></div
          ></div
          ><PlusSmall class="m-9ygqym" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusSmall
          ><PlusSmall class="m-nz0w8o" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusSmall
          ><PlusSmall class="m-oa3lw0" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusSmall
          ><PlusSmall class="m-1ni1w4e" style="--mucckr:var(--color-accent, rgb(0, 255, 161))"></PlusSmall
        ></div
        ><div class="m-3dc01a"
          ><div class="m-1hf4fv4" style="--extracted-1w1cjl5:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;--extracted-r6o4lv:var(--color-white, rgb(255, 255, 255));transform:none"
            ><p class="rt type-y2tuor" dir="auto" style="--m-text-color:var(--extracted-r6o4lv, var(--color-white, rgb(255, 255, 255)))">{name}</p
          ></div
          ><div class="m-1yd5xi8" style="--extracted-r6o4lv:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;transform:none"
            ><p class="rt type-54rzwz" dir="auto" style="--m-text-alignment:right;--m-text-color:var(--extracted-r6o4lv, var(--color-white, rgb(255, 255, 255)))">{position}</p
          ></div
        ></div
      ></div></Fragment
    >
  ) : null
}