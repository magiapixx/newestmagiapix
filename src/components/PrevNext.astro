---
// Prev - Next: one markup for every breakpoint (lib/rv); the hover accent exists only in the desktop look
import AnimationAccent from './AnimationAccent.astro';
import { rv } from '../lib/rv';

interface Props {
  side: "Right" | "Left";
  link: string;
  dataSrc: string;
  text: string;
}

const { side, link, dataSrc, text } = Astro.props;
const VARIANTS = {
  "Right": "v-t5hhwz",
  "Phone - Right": "v-1wp22es",
  "Tablet - Right": "v-1yo5haf",
  "Left": "v-1lbfoh3",
  "Phone - Left": "v-tm6r7l",
  "Tablet - Left": "v-85hoj",
};
const look = rv({ lg: VARIANTS[side], xl: VARIANTS[side], t: VARIANTS[`Tablet - ${side}`], p: VARIANTS[`Phone - ${side}`] });
const textType = rv({ lg: 'type-9iwysc', xl: 'type-9iwysc', t: 'type-1qeok15', p: 'type-y2tuor' });
const style = `--m-text-alignment:${side.toLowerCase()};--m-text-color:var(--extracted-1eung3n, var(--color-white, rgb(255, 255, 255)))`;
---

<a class:list={["m-Rmgej m-OjHb3 m-5BKxZ m-xbhBc m-1lbfoh3 m-13oxro1", look]} href={link} style="width:100%"
  ><div class="m-m838et-container" style="will-change:transform;opacity:0;transform:none" data-reveal="{&quot;from&quot;:{&quot;opacity&quot;:0},&quot;transition&quot;:{&quot;bounce&quot;:0,&quot;delay&quot;:0.2,&quot;duration&quot;:0.5,&quot;type&quot;:&quot;spring&quot;},&quot;threshold&quot;:0}"
    ><div style="width:100%;position:relative;height:auto;min-height:0;max-height:none;aspect-ratio:1.7777777777777777;overflow:hidden;background:transparent"
      ><canvas style="position:absolute;inset:0;display:block;width:100%;height:100%" data-gl="pixel-flip" data-src={dataSrc} aria-hidden="true"></canvas
    ></div
  ></div
  ><div class="m-1cxexmk" style="--extracted-1eung3n:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;--extracted-r6o4lv:var(--color-white, rgb(255, 255, 255));--extracted-1lwpl3i:var(--color-white, rgb(255, 255, 255));transform:none"
    ><h4 class={`rt ${textType}`} dir="auto" style={style}>{text}</h4
  ></div
  ><div class="m-14j2mgk-container hide-tablet hide-phone" data-show="hover"
    ><AnimationAccent variant="v-1ejt96b" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
  ></div
></a>
