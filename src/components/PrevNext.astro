---
// Prev - Next
import AnimationAccent from './AnimationAccent.astro';

interface Props {
  variant?: "Right" | "Phone - Right" | "Tablet - Right" | "Left" | "Phone - Left" | "Tablet - Left";
  link: string;
  dataSrc: string;
  style: string;
  text: string;
}

const { variant = "Right", link, dataSrc, style, text } = Astro.props;

const VARIANTS = {
  "Right": "v-t5hhwz",
  "Phone - Right": "v-1wp22es",
  "Tablet - Right": "v-1yo5haf",
  "Left": "v-1lbfoh3",
  "Phone - Left": "v-tm6r7l",
  "Tablet - Left": "v-85hoj",
};
---

{
  variant === "Right" || variant === "Left" ? (
    <Fragment
      ><a class:list={["m-Rmgej m-OjHb3 m-5BKxZ m-xbhBc m-1lbfoh3 m-13oxro1", VARIANTS[variant]]} href={link} style="width:100%"
        ><div class="m-m838et-container" style="will-change:transform;opacity:0;transform:none" data-reveal="{&quot;from&quot;:{&quot;opacity&quot;:0},&quot;transition&quot;:{&quot;bounce&quot;:0,&quot;delay&quot;:0.2,&quot;duration&quot;:0.5,&quot;type&quot;:&quot;spring&quot;},&quot;threshold&quot;:0}"
          ><div style="width:100%;position:relative;height:auto;min-height:0;max-height:none;aspect-ratio:1.7777777777777777;overflow:hidden;background:transparent"
            ><canvas style="position:absolute;inset:0;display:block;width:100%;height:100%" data-gl="pixel-flip" data-src={dataSrc} aria-hidden="true"></canvas
          ></div
        ></div
        ><div class="m-1cxexmk" style="--extracted-1eung3n:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;transform:none"
          ><h4 class="rt type-9iwysc" dir="auto" style={style}>{text}</h4
        ></div
        ><div class="m-14j2mgk-container" data-show="hover"
          ><AnimationAccent variant="v-1ejt96b" style="height:100%;width:100%" style2="background-color:var(--color-accent, rgb(0, 255, 161))"></AnimationAccent
        ></div
      ></a></Fragment
    >
  ) : variant === "Phone - Right" || variant === "Phone - Left" ? (
    <Fragment
      ><a class:list={["m-Rmgej m-OjHb3 m-5BKxZ m-xbhBc m-1lbfoh3 m-13oxro1", VARIANTS[variant]]} href={link} style="width:100%"
        ><div class="m-m838et-container" style="will-change:transform;opacity:0;transform:none" data-reveal="{&quot;from&quot;:{&quot;opacity&quot;:0},&quot;transition&quot;:{&quot;bounce&quot;:0,&quot;delay&quot;:0.2,&quot;duration&quot;:0.5,&quot;type&quot;:&quot;spring&quot;},&quot;threshold&quot;:0}"
          ><div style="width:100%;position:relative;height:auto;min-height:0;max-height:none;aspect-ratio:1.7777777777777777;overflow:hidden;background:transparent"
            ><canvas style="position:absolute;inset:0;display:block;width:100%;height:100%" data-gl="pixel-flip" data-src={dataSrc} aria-hidden="true"></canvas
          ></div
        ></div
        ><div class="m-1cxexmk" style="--extracted-1eung3n:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;--extracted-r6o4lv:var(--color-white, rgb(255, 255, 255));transform:none"
          ><p class="rt type-y2tuor" dir="auto" style={style}>{text}</p
        ></div
      ></a></Fragment
    >
  ) : variant === "Tablet - Right" || variant === "Tablet - Left" ? (
    <Fragment
      ><a class:list={["m-Rmgej m-OjHb3 m-5BKxZ m-xbhBc m-1lbfoh3 m-13oxro1", VARIANTS[variant]]} href={link} style="width:100%"
        ><div class="m-m838et-container" style="will-change:transform;opacity:0;transform:none" data-reveal="{&quot;from&quot;:{&quot;opacity&quot;:0},&quot;transition&quot;:{&quot;bounce&quot;:0,&quot;delay&quot;:0.2,&quot;duration&quot;:0.5,&quot;type&quot;:&quot;spring&quot;},&quot;threshold&quot;:0}"
          ><div style="width:100%;position:relative;height:auto;min-height:0;max-height:none;aspect-ratio:1.7777777777777777;overflow:hidden;background:transparent"
            ><canvas style="position:absolute;inset:0;display:block;width:100%;height:100%" data-gl="pixel-flip" data-src={dataSrc} aria-hidden="true"></canvas
          ></div
        ></div
        ><div class="m-1cxexmk" style="--extracted-1eung3n:var(--color-white, rgb(255, 255, 255));--m-paragraph-spacing:0px;--extracted-1lwpl3i:var(--color-white, rgb(255, 255, 255));transform:none"
          ><h5 class="rt type-1qeok15" dir="auto" style={style}>{text}</h5
        ></div
      ></a></Fragment
    >
  ) : null
}