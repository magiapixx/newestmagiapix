---
// Industry - Card (was Award - Card): one markup for every breakpoint (lib/rv). Hover (desktop look only) is in scripts/components/award.ts;
// the tablet/phone text colours that copy set inline are in site.css.
import AnimationAccent from './AnimationAccent.astro';
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import LineBold from './LineBold.astro';
import { rv } from '../lib/rv';

const look = rv({ lg: 'v-1ezkko', xl: 'v-1ezkko', t: 'v-s57m7r', p: 'v-drqb51' });
const nameType = rv({ lg: 'type-1e97z2c', xl: 'type-1e97z2c', t: 'type-1ff3dg', p: 'type-1ff3dg' });

interface Props {
  name: string;
  client: string;
  type: string;
  year: string;
  link?: string;
  cta?: string;
}

const { name, client, type, year, link = "/contact/", cta = "Start a project" } = Astro.props;
---

<a class:list={["m-i7kYl m-pQ5hH m-alehh m-lhYZM m-3UBND m-xbhBc m-1ezkko m-4w5ck7", look]} href={link} style="background-color:var(--color-white, rgb(255, 255, 255));width:100%"
  ><div class="m-exb53o"
    ><div class="m-1kk4hg7"
      ><div class="m-8p26xb" style="--m-paragraph-spacing:0px;opacity:1;transform:none"
        ><h5 class={`rt ${nameType}`} dir="auto" style="--m-text-color:var(--extracted-1lwpl3i, var(--color-black, rgb(0, 0, 0)))">{name}</h5
      ></div
    ></div
    ><div class="m-1pqlvmn"
      ><div class="m-1gedq9b" style="--m-paragraph-spacing:0px;transform:none"
        ><p class="rt type-m3s7sn" dir="auto" style="--m-text-color:var(--extracted-r6o4lv, var(--color-black, rgb(0, 0, 0)))">{client}</p
      ></div
    ></div
    ><div class="m-1kq3850"
      ><div class="m-wg9mlt" style="--m-paragraph-spacing:0px;transform:none"
        ><p class="rt type-54rzwz" dir="auto" style="--m-text-color:var(--extracted-r6o4lv, var(--color-black, rgb(0, 0, 0)))">{type}</p
      ></div
    ></div
    ><div class="m-11e43yq"
      ><div class="m-9yt2ny" style="--m-paragraph-spacing:0px;transform:none"
        ><p class="rt type-y2tuor" dir="auto" style="--m-text-alignment:right;--m-text-color:var(--extracted-r6o4lv, var(--color-black, rgb(0, 0, 0)))">{year}</p
      ></div
      ><ExternalLinkIcon></ExternalLinkIcon
    ></div
  ></div
  ><div class="m-17v03n0-container hide-tablet hide-phone" data-show="hover"
    ><AnimationAccent variant="Load and Fill - End" style="height: 100%;width: 100%" style2="background-color: var(--color-black, rgb(0, 0, 0))"></AnimationAccent
  ></div
  ><div class="m-1m661c6 hide-lg hide-xl"
    ><div class="m-1eahvdf" style="--extracted-r6o4lv:var(--color-black, rgb(0, 0, 0));--m-paragraph-spacing:0px;transform:none"
      ><p class="rt type-54rzwz" dir="auto" style="--m-text-color:var(--extracted-r6o4lv, var(--color-black, rgb(0, 0, 0)))">{cta}</p
    ></div
    ><LineBold></LineBold
  ></div
></a>
