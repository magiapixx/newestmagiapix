---
import '../styles/fonts.css';
import '../styles/site.css';
import '../styles/breakpoints.css';
import '../styles/component-states.css';
import '../styles/interactions.css';
import PageIntro from '../components/PageIntro.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// set `site` in astro.config.mjs to get absolute canonical/og URLs
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/meta/og-image.jpg', Astro.site).href : '/meta/og-image.jpg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/meta/favicon.png" />
    <link rel="apple-touch-icon" href="/meta/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content="max-image-preview:large" />
  </head>
  <body>
    <PageIntro />
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
