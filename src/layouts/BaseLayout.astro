---
import '../styles/fonts.css';
import '../styles/site.css';
import '../styles/breakpoints.css';
import '../styles/component-states.css';
import '../styles/interactions.css';
import PageIntro from '../components/PageIntro.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// set `site` in astro.config.mjs to get absolute canonical/og URLs
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/meta/og-image.jpg', Astro.site).href : '/meta/og-image.jpg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/meta/favicon.png" />
    <link rel="apple-touch-icon" href="/meta/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content="max-image-preview:large" />
    <script is:inline>
      // Desktop sizes are fixed px that look right from about 1707x811 up (a 1920x1080 screen at 100%
      // shows ~1920x950). On smaller desktop screens, e.g. a 15" laptop at 125% scaling (1536x730),
      // scale the whole page down like browser zoom would: html { zoom: --z }. Full-screen lengths
      // (vh, 100vw) divide by --z so they still fill the screen; scripts/lib/zoom.ts covers the JS side.
      (function () {
        var root = document.documentElement;
        function fit() {
          var w = innerWidth, h = innerHeight;
          var z = w < 1200 ? 1 : Math.min(1, Math.max(0.75, Math.min(w / 1707, h / 811)));
          z = Math.round(z * 100) / 100;
          root.style.setProperty('--z', String(z));
          root.style.zoom = z === 1 ? '' : String(z);
        }
        fit();
        addEventListener('resize', fit);
      })();
    </script>
  </head>
  <body>
    <PageIntro />
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
