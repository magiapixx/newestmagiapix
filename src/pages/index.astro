              ><SubscriptionSection variant="Desktop" headingsVerticalVariant="/Subscription - H1"></SubscriptionSection
            ></div
            ><div class="bp hide-lg hide-xl"
              ><SubscriptionSection variant="Tablet" headingsVerticalVariant="/Subscription - H2"></SubscriptionSection
            ></div
            ><div class="bp hide-tablet hide-lg"
              ><SubscriptionSection variant="Wide" headingsVerticalVariant="/Subscription - H1"></SubscriptionSection
            ></div
          ></div
        ></div
        ><div class="bp hide-tablet hide-lg hide-xl"
          ><div class="m-paz1jq-container" id="Subscription" data-nav-theme="light"
            ><SubscriptionSection variant="Phone"></SubscriptionSection
          ></div
        ></div
        ><div class="bp hide-phone"
          ><div class="m-1bg3m36-container" id="prices"
