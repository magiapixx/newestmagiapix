---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from '../components/AboutSection.astro';
import CasesSection from '../components/CasesSection.astro';
import CtaSection from '../components/CtaSection.astro';
import FooterSection from '../components/FooterSection.astro';
import HeroSection from '../components/HeroSection.astro';
import Navigation from '../components/Navigation.astro';
import PricesSection from '../components/PricesSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import ShowreelSection from '../components/ShowreelSection.astro';
import WhyUsSection from '../components/WhyUsSection.astro';
---

<BaseLayout title="Magiapix — Digital & Creative Agency" description="Magiapix is a digital and creative agency for brands, studios and small teams.">
  <div id="main" data-smooth-scroll="12"
    ><div class="m-VOZrd m-1p7p7oi" style="min-height:100vh;width:auto"
      ><div class="m-ho6gy m-72rtr7" style="min-height:100vh;width:auto;display:contents"
        ><div class="m-192izcr-container" style="transform:translateX(-50%)"
          ><Navigation></Navigation
        ></div
        ><div class="m-rxibub-container" id="hero"
          ><HeroSection></HeroSection
        ></div
        ><div class="m-wkn3iw-container" id="about"
          ><AboutSection></AboutSection
        ></div
        ><div class="m-172hv11-container" id="Services" data-nav-theme="dark"
          ><ServicesSection></ServicesSection
        ></div
        ><div class="m-1ntdfpz-container" id="cases"
          ><CasesSection></CasesSection
        ></div
        ><div class="m-cfbga4-container" id="showreel"
          ><ShowreelSection></ShowreelSection
        ></div
        ><div class="m-paz1jq-container" id="why-us" data-nav-theme="light"
          ><WhyUsSection></WhyUsSection
        ></div
        ><div class="m-1bg3m36-container" id="prices"
          ><PricesSection></PricesSection
        ></div
        ><div class="cta-container" id="start-project" data-nav-theme="light"
          ><CtaSection></CtaSection
        ></div
      ></div
      ><div id="overlay"></div
      ><div class="m-h650cb"></div
      ><div class="m-vouzml-container"
        ><FooterSection linkWithLineSmallLink="/about/#contact"></FooterSection
      ></div
    ></div
    ><div id="template-overlay"></div
  ></div>
</BaseLayout>
