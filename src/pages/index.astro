              ><CasesSection variant="Desktop" style="background-color:var(--color-white, rgb(255, 255, 255));width:100%" headingsVerticalVariant="/Cases - H1 Light Back" caseCardVariationsVariant="Desktop - Left" caseCardVariationsCaseCardVariant="Desktop" caseCardVariationsVariant2="Desktop - Right"></CasesSection
            ></div
            ><div class="bp hide-lg"
              ><CasesSection variant="Tablet" style="background-color:var(--color-white, rgb(255, 255, 255));width:100%" headingsVerticalVariant="/Cases - H2 Light Back" caseCardVariationsVariant="Tablet - Left" caseCardVariationsCaseCardVariant="Tablet" caseCardVariationsVariant2="Tablet - Right"></CasesSection
            ></div
          ></div
        ></div
        ><div class="bp hide-tablet hide-lg hide-xl"
          ><div class="m-1ntdfpz-container" id="cases"
            ><CasesSection variant="Phone"></CasesSection
          ></div
        ></div
        ><div class="bp hide-tablet hide-phone hide-lg"
          ><div class="m-1ntdfpz-container" id="cases"
            ><CasesSection variant="Wide" style="background-color:var(--color-white, rgb(255, 255, 255));max-width:100%;width:100%" headingsVerticalVariant="/Cases - H1 Light Back" caseCardVariationsVariant="Desktop - Left - Wide" caseCardVariationsCaseCardVariant="Desktop" caseCardVariationsVariant2="Desktop - Right - Wide"></CasesSection
          ></div
        ></div
        ><div class="bp hide-phone"
          ><div class="m-cfbga4-container" id="showreel"
            ><div class="bp hide-tablet hide-xl"
              ><ShowreelSection variant="Desktop" headingsVerticalVariant="/Show - H1 Light Back" headingsVerticalVariant2="Reel - H1 Light Back"></ShowreelSection
            ></div
            ><div class="bp hide-lg hide-xl"
              ><ShowreelSection variant="Tablet" headingsVerticalVariant="/Show - H2 Light Back" headingsVerticalVariant2="Reel - H2 Light Back"></ShowreelSection
            ></div
            ><div class="bp hide-tablet hide-lg"
              ><ShowreelSection variant="Wide" headingsVerticalVariant="/Show - H1 Light Back" headingsVerticalVariant2="Reel - H1 Light Back"></ShowreelSection
            ></div
          ></div
        ></div
        ><div class="bp hide-tablet hide-lg hide-xl"
          ><div class="m-cfbga4-container" id="showreel"
            ><ShowreelSection variant="Phone"></ShowreelSection
          ></div
        ></div
        ><div class="bp hide-phone"
          ><div class="m-paz1jq-container" id="Subscription" data-nav-theme="light"
