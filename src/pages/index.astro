---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from '../components/AboutSection.astro';
import CasesSection from '../components/CasesSection.astro';
import ClientsTicker from '../components/ClientsTicker.astro';
import FooterSection from '../components/FooterSection.astro';
import HeroSection from '../components/HeroSection.astro';
import Navigation from '../components/Navigation.astro';
import PricesSection from '../components/PricesSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import ShowreelSection from '../components/ShowreelSection.astro';
import SubscriptionSection from '../components/SubscriptionSection.astro';
---

<BaseLayout title="Magiapix — Digital & Creative Agency" description="Magiapix is a digital and creative agency for brands, studios and small teams.">
  <div id="main" data-smooth-scroll="12"
    ><div class="m-VOZrd m-1p7p7oi" style="min-height:100vh;width:auto"
      ><div class="m-ho6gy m-72rtr7" style="min-height:100vh;width:auto;display:contents"
        ><div class="m-192izcr-container" style="transform:translateX(-50%)"
          ><div class="bp hide-tablet hide-phone"
            ><Navigation variant="Desktop"></Navigation
          ></div
          ><div class="bp hide-phone hide-lg hide-xl"
            ><Navigation variant="Tablet"></Navigation
          ></div
          ><div class="bp hide-tablet hide-lg hide-xl"
            ><Navigation variant="Phone"></Navigation
          ></div
        ></div
        ><div class="bp hide-phone"
          ><div class="m-rxibub-container" id="hero"
            ><div class="bp hide-tablet hide-xl"
              ><HeroSection variant="Desktop" headingsVerticalVariant="Scroll Down - H6"></HeroSection
            ></div
            ><div class="bp hide-lg hide-xl"
              ><HeroSection variant="Tablet" headingsVerticalVariant="Scroll Down - H6 - Smaller"></HeroSection
            ></div
            ><div class="bp hide-tablet hide-lg"
              ><HeroSection variant="Wide" headingsVerticalVariant="Scroll Down - H6"></HeroSection
            ></div
          ></div
        ></div
        ><div class="bp hide-tablet hide-lg hide-xl"
          ><div class="m-rxibub-container" id="hero"
            ><HeroSection variant="Phone"></HeroSection
          ></div
        ></div
        ><div class="bp hide-phone"
          ><div class="m-wkn3iw-container" id="about"
            ><div class="bp hide-tablet hide-xl"
              ><AboutSection variant="Desktop" textBackAnimationVariant="Normal" text2Style={"font-family:\"Zalando Sans Variable\", \"Zalando Sans Variable Placeholder\", sans-serif;font-size:20px;font-style:normal;font-weight:540;letter-spacing:0.15px;line-height:23px;text-align:left;font-variation-settings:\"wght\" 540;-webkit-font-variation-settings:\"wght\" 540;--m-font-weight:540;--m-font-variation-axes:\"wght\" 540;--m-font-variation-axes-preview:\"wght\" 540;margin:0;padding:0;color:var(--color-white, rgb(255, 255, 255));white-space:pre-wrap;overflow-wrap:break-word"}></AboutSection
            ></div
            ><div class="bp hide-lg hide-xl"
              ><AboutSection variant="Tablet"></AboutSection
            ></div
            ><div class="bp hide-tablet hide-lg"
              ><AboutSection variant="Wide" textBackAnimationVariant="H4" text2Style={"font-family:\"Zalando Sans Variable\", \"Zalando Sans Variable Placeholder\", sans-serif;font-size:36px;font-style:normal;font-weight:475;letter-spacing:-1px;line-height:37px;text-align:left;font-variation-settings:\"wght\" 475;-webkit-font-variation-settings:\"wght\" 475;--m-font-weight:475;--m-font-variation-axes:\"wght\" 475;--m-font-variation-axes-preview:\"wght\" 475;margin:0;padding:0;color:var(--color-white, rgb(255, 255, 255));white-space:pre-wrap;overflow-wrap:break-word"}></AboutSection
            ></div
          ></div
        ></div
        ><div class="bp hide-tablet hide-lg hide-xl"
          ><div class="m-wkn3iw-container" id="about"
            ><AboutSection variant="Phone"></AboutSection
          ></div
        ></div
        ><div class="bp hide-phone"
          ><div class="m-172hv11-container" id="Services" data-nav-theme="dark"
            ><div class="bp hide-tablet hide-xl"
              ><ServicesSection variant="Desktop" headingsVerticalVariant="/Services - H1 Light Back" serviceStyle="--sezid2:7px 0px 0px 0px" serviceText={"Visual\nIdentity"} serviceHasBlock serviceInverseStyle="--1ijwx7z:6px 0px 0px 0px" serviceText3={"Creative\nDevelopment "}></ServicesSection
            ></div
            ><div class="bp hide-lg hide-xl"
              ><ServicesSection variant="Tablet" headingsVerticalVariant="/Services - H2 Light Back" serviceStyle="--sezid2:4px 0px 0px 0px" serviceText2={"Visual\nIdentity"} serviceHasBlock2 serviceInverseStyle="--1ijwx7z:3px 0px 0px 0px" serviceText22={"Creative\nDevelopment "}></ServicesSection
            ></div
            ><div class="bp hide-tablet hide-lg"
              ><ServicesSection variant="Wide" headingsVerticalVariant="/Services - H1 Light Back" serviceStyle="--sezid2:7px 0px 0px 0px" serviceText={"Visual\nIdentity"} serviceHasBlock serviceInverseStyle="--1ijwx7z:6px 0px 0px 0px" serviceText3={"Creative\nDevelopment "}></ServicesSection
            ></div
          ></div
