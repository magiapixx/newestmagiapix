---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutAndMetricsSection from '../../components/AboutAndMetricsSection.astro';
import AboutPageHeader from '../../components/AboutPageHeader.astro';
import IndustriesSection from '../../components/IndustriesSection.astro';
import FAQSection from '../../components/FAQSection.astro';
import FooterSection from '../../components/FooterSection.astro';
import FormSection from '../../components/FormSection.astro';
import Navigation from '../../components/Navigation.astro';
import TeamSection from '../../components/TeamSection.astro';
---

<BaseLayout title="About — Magiapix" description="Magiapix is a digital and creative agency for brands, studios and small teams.">
  <div id="main" data-smooth-scroll="12"
    ><div class="m-VOZrd m-1p7p7oi" style="min-height:calc(100vh / var(--z, 1));width:auto"
      ><div class="m-KY3If m-12qmj22" style="min-height:calc(100vh / var(--z, 1));width:auto;display:contents"
        ><div class="m-1ujso5a-container" style="transform:translateX(-50%)"
          ><Navigation></Navigation
        ></div
        ><div class="m-3970hr-container"
          ><AboutPageHeader></AboutPageHeader
        ></div
        ><div class="m-1tl2vdc-container" id="about-and-metrics" data-nav-theme="light"
          ><AboutAndMetricsSection></AboutAndMetricsSection
        ></div
        >{/* Team section hidden for now; restore by uncommenting:
        <div class="m-edzw7o-container"
          ><TeamSection></TeamSection
        ></div
        */}<div class="m-167ihsi-container"
          ><IndustriesSection></IndustriesSection
        ></div
        ><div class="m-qaond6-container" id="faq" data-nav-theme="light"
          ><FAQSection></FAQSection
        ></div
        ><div class="m-qaond6-container" id="contact" data-nav-theme="dark" style="scroll-margin-top:100px"
          ><FormSection></FormSection
        ></div
      ></div
      ><div id="overlay"></div
      ><div class="m-h650cb"></div
      ><div class="m-vouzml-container"
        ><FooterSection linkWithLineSmallLink="/about/#contact"></FooterSection
      ></div
    ></div
    ><div id="template-overlay"></div
  ></div>
</BaseLayout>
