---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCardVariations from '../../components/CaseCardVariations.astro';
import CasesPageHeader from '../../components/CasesPageHeader.astro';
import ClientsTicker from '../../components/ClientsTicker.astro';
import FooterSection from '../../components/FooterSection.astro';
import HeadingsVertical from '../../components/HeadingsVertical.astro';
import Navigation from '../../components/Navigation.astro';
---

<BaseLayout title="Cases — Magiapix" description="Magiapix is a digital and creative agency for brands, studios and small teams.">
  <div id="main" data-smooth-scroll="12"
    ><div class="m-VOZrd m-1p7p7oi" style="min-height:100vh;width:auto"
      ><div class="m-2bT3N m-alehh m-bf5jqr" style="min-height:100vh;width:auto;display:contents"
        ><div class="m-7rk94s-container" style="transform:translateX(-50%)"
          ><Navigation></Navigation
        ></div
        ><div class="m-z3ycm0-container"
          ><CasesPageHeader></CasesPageHeader
        ></div
        ><section class="m-1ccnly2" id="cases" data-nav-theme="dark"
          ><div class="bp"
            ><div class="m-wn2izs-container hide-phone"
              ><HeadingsVertical variant="/2012-2026 - H3 Light Back" first="/2012-2026"></HeadingsVertical
            ></div
          ></div
          ><div class="m-196kn2u-container"
            ><CaseCardVariations variants={{ p: "Phone", t: "Desktop - Left", lg: "Desktop - Left", xl: "Desktop - Left - Wide" }} caseCardVariants={{ p: "Phone", t: "Desktop", lg: "Desktop", xl: "Desktop" }} caseCardLink="/cases/armada/" caseCardDataSrc="/images/nPXcfgWdT5K8JbvlDs4VQhhws.jpg" caseCardText="Armada" caseCardText2="/26"></CaseCardVariations
          ></div
          ><div class="m-lg33gy-container"
            ><CaseCardVariations variants={{ p: "Phone", t: "Tablet - Right", lg: "Desktop - Right", xl: "Desktop - Right - Wide" }} caseCardVariants={{ p: "Phone", t: "Tablet", lg: "Desktop", xl: "Desktop" }} caseCardLink="/cases/montana/" caseCardDataSrc="/images/RFdcBAQsIqs2cwSENiDPQN8xt8.jpg" caseCardText="Montana" caseCardText2="/26"></CaseCardVariations
          ></div
          ><div class="m-yx1po5-container"
            ><CaseCardVariations variants={{ p: "Phone", t: "Desktop - Left", lg: "Desktop - Left", xl: "Desktop - Left - Wide" }} caseCardVariants={{ p: "Phone", t: "Desktop", lg: "Desktop", xl: "Desktop" }} caseCardLink="/cases/pirate-hub/" caseCardDataSrc="/images/bLvotkjf6dFGxyiS1gfV2zCoAI.jpg" caseCardText="Pirate Hub" caseCardText2="/26"></CaseCardVariations
          ></div
          ><div class="m-11y3xu7-container"
            ><CaseCardVariations variants={{ p: "Phone", t: "Tablet - Right", lg: "Desktop - Right", xl: "Desktop - Right - Wide" }} caseCardVariants={{ p: "Phone", t: "Tablet", lg: "Desktop", xl: "Desktop" }} caseCardLink="/cases/calderone/" caseCardDataSrc="/images/4zmvB84YdDqvaIgOFHPAk2SGOXI.jpg" caseCardText="Calderone" caseCardText2="/25"></CaseCardVariations
          ></div
          ><div class="m-y07l1p-container"
            ><CaseCardVariations variants={{ p: "Phone", t: "Desktop - Left", lg: "Desktop - Left", xl: "Desktop - Left - Wide" }} caseCardVariants={{ p: "Phone", t: "Desktop", lg: "Desktop", xl: "Desktop" }} caseCardLink="/cases/oasis/" caseCardDataSrc="/images/rAJGys7D5In5EzOU3L5miGh8ks.jpg" caseCardText="Oasis" caseCardText2="/25"></CaseCardVariations
          ></div
          ><div class="m-1krtg6r hide-lg hide-tablet hide-xl"
            ><div class="m-bhbrs5 hide-lg" style="transform:none"
              ><h6 class="rt type-1ff3dg" dir="auto" style="--m-text-alignment:right;--m-text-color:var(--color-black, rgb(0, 0, 0))">/2012-2026</h6
            ></div
          ></div
        ></section
        ><div class="m-18j1oea" id="end" data-nav-theme="light"></div
      ></div
      ><div id="overlay"></div
      ><div class="m-h650cb"></div
      ><div class="m-63qbpk-container"
        ><ClientsTicker></ClientsTicker> </div
      ><div class="m-vouzml-container"
        ><FooterSection linkWithLineSmallLink="/contact/"></FooterSection
      ></div
    ></div
    ><div id="template-overlay"></div
  ></div>
</BaseLayout>
